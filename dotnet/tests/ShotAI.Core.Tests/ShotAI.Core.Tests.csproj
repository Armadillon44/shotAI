<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- xunit.v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>ShotAI.Core.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ShotAI.Core\ShotAI.Core.csproj" />
  </ItemGroup>
  <!--
    contract/ is shared byte-for-byte with the macOS repo, so it is read in place from
    the repo root and never copied into dotnet/. Linking it into the test output lets
    the suite find it regardless of the working directory.
  -->
  <ItemGroup>
    <None Include="$(RepoRoot)contract/**/*" LinkBase="contract" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!--
    Goldens (docs/native/PLAN.md 2.7), compared byte for byte. Listed explicitly, because the
    SDK's default items skip dot folders such as the fixture's export/.render/.
  -->
  <ItemGroup>
    <None Remove="Golden/**" />
    <None Include="Golden/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The 87-channel map of spec 11 7.4, read by ServiceBoundary.ChannelInventoryTests. -->
  <ItemGroup>
    <None Include="ServiceBoundary/channel-map.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
