<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The C# brand generator (docs/native/spec/10-brand-settings-infra.md 7.3): reads
    contract/brand.json in place and writes src/ShotAI.Core/Brand/BrandPalette.Generated.cs.
    BCL only, like scripts/gen-brand.mjs is Node builtins only. It references no project of
    the solution, so it still builds when the generated file it repairs does not
    (EDGE-INFRA-48), and Directory.Build.props gives it no analyzer package.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>ShotAI.GenBrand</RootNamespace>
  </PropertyGroup>
</Project>
