<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Windows platform services: Win32 and WinRT interop (hooks, screen capture, UI
    Automation, display affinity, DPAPI, policy registry, OCR, the WebView2 PDF host,
    libavif). P/Invoke signatures are generated by CsWin32 from NativeMethods.txt,
    never hand-written.
  -->
  <PropertyGroup>
    <TargetFramework>$(ShotAIWindowsTfm)</TargetFramework>
    <SupportedOSPlatformVersion>$(ShotAIMinWindows)</SupportedOSPlatformVersion>
    <RootNamespace>ShotAI.Platform</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ShotAI.Core\ShotAI.Core.csproj" />
  </ItemGroup>
  <!-- The seam implementations are internal sealed (INV-ARCH-4); their tests reach them directly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="ShotAI.Platform.Tests" />
  </ItemGroup>
</Project>
