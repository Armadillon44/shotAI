<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:chrome="clr-namespace:ShotAI.App.Chrome"
                    xmlns:corehome="clr-namespace:ShotAI.Core.Home;assembly=ShotAI.Core">
  <!--
    The shared control styles (spec 06 2.34 and 7.5): one keyed style per Electron class family,
    with Electron's measurements in DIP (1rem = 16) and every colour, radius and font read from
    the theme dictionary with DynamicResource (INV-HOME-24, INV-HOME-25).

    A corner that may be a capsule (every radius-chip) is bound through CapsuleCornerConverter
    from the element's height and RadiusValue.chip, which the Border carries in its Tag: WPF
    has no CSS clamp for border-radius: 999px.

    CSS applies the later rule of equal specificity, and :hover:not(:disabled) outranks a
    modifier class, so each style's hover trigger comes after its checked trigger.
  -->

  <!-- The fixed colours, merged here so this dictionary's StaticResource reads resolve wherever it is loaded. -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="FixedColors.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <chrome:CapsuleCornerConverter x:Key="CapsuleCornerConverter" />
  <chrome:UpperCaseConverter x:Key="UpperCaseConverter" />

  <!-- :focus-visible: a 2 DIP accent outline 2 DIP outside the element, micro corners. WPF shows it for keyboard focus only. -->
  <Style x:Key="FocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-4" StrokeThickness="2" Stroke="{DynamicResource Brush.focus-visible}"
                     RadiusX="{DynamicResource RadiusValue.micro}" RadiusY="{DynamicResource RadiusValue.micro}"
                     SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Buttons: btn and its modifiers ===== -->

  <!-- btn: 0.55rem 0.95rem, 1px control-bd, radius-control, surface, ink, 0.9rem, no wrap; hover surface-2; disabled 0.55. -->
  <Style x:Key="Button.Base" TargetType="ButtonBase">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Background" Value="{DynamicResource Brush.surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.ink}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.control-bd}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="15.2,8.8" />
    <Setter Property="FontSize" Value="14.4" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Radius.control}">
            <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsMouseOver" Value="True" />
          <Condition Property="IsEnabled" Value="True" />
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource Brush.surface-2}" />
      </MultiTrigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.55" />
        <Setter Property="Cursor" Value="Arrow" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- btn small: 0.3rem 0.7rem, 0.8rem. -->
  <Style x:Key="Button.Small" TargetType="ButtonBase" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Padding" Value="11.2,4.8" />
    <Setter Property="FontSize" Value="12.8" />
  </Style>

  <!-- btn primary: accent border and fill, on-accent text; hover accent-press. -->
  <Style x:Key="Button.Primary" TargetType="ButtonBase" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="{DynamicResource Brush.accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.on-accent}" />
    <Style.Triggers>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsMouseOver" Value="True" />
          <Condition Property="IsEnabled" Value="True" />
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource Brush.accent-press}" />
      </MultiTrigger>
    </Style.Triggers>
  </Style>

  <!-- btn btn-small btn-primary: a row's Open button (06 2.12). -->
  <Style x:Key="Button.SmallPrimary" TargetType="ButtonBase" BasedOn="{StaticResource Button.Primary}">
    <Setter Property="Padding" Value="11.2,4.8" />
    <Setter Property="FontSize" Value="12.8" />
  </Style>

  <!-- btn danger: danger-ink text, danger-bd border; hover danger-tint fill and danger border. -->
  <Style x:Key="Button.Danger" TargetType="ButtonBase" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.danger-ink}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.danger-bd}" />
    <Style.Triggers>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsMouseOver" Value="True" />
          <Condition Property="IsEnabled" Value="True" />
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource Brush.danger-tint}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.danger}" />
      </MultiTrigger>
    </Style.Triggers>
  </Style>

  <!-- btn ghost: transparent border and fill, ink-2; hover accent-tint fill and ink. -->
  <Style x:Key="Button.Ghost" TargetType="ButtonBase" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.ink-2}" />
    <Style.Triggers>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsMouseOver" Value="True" />
          <Condition Property="IsEnabled" Value="True" />
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource Brush.accent-tint}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.ink}" />
      </MultiTrigger>
    </Style.Triggers>
  </Style>

  <!-- btn btn-small btn-ghost: Home's Import button (06 2.8). -->
  <Style x:Key="Button.SmallGhost" TargetType="ButtonBase" BasedOn="{StaticResource Button.Ghost}">
    <Setter Property="Padding" Value="11.2,4.8" />
    <Setter Property="FontSize" Value="12.8" />
  </Style>

  <!-- The overflow trigger's btn btn-small btn-ghost btn-icon: small and ghost, 0.3rem 0.5rem, line-height 1. -->
  <Style x:Key="Button.Icon" TargetType="ButtonBase" BasedOn="{StaticResource Button.Ghost}">
    <Setter Property="Padding" Value="8,4.8" />
    <Setter Property="FontSize" Value="12.8" />
    <Setter Property="TextBlock.LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="TextBlock.LineHeight" Value="12.8" />
  </Style>

  <!-- ===== Chips ===== -->

  <!-- capmode chip: 0.4rem 0.85rem, 1px control-bd, radius-chip, surface, ink, 0.88rem; on: accent border, accent-tint, accent-ink, 600; hover surface-2. -->
  <Style x:Key="Chip" TargetType="RadioButton">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Background" Value="{DynamicResource Brush.surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.ink}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.control-bd}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="13.6,6.4" />
    <Setter Property="FontSize" Value="14.08" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" Tag="{DynamicResource RadiusValue.chip}">
            <Border.CornerRadius>
              <MultiBinding Converter="{StaticResource CapsuleCornerConverter}">
                <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
              </MultiBinding>
            </Border.CornerRadius>
            <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.accent}" />
        <Setter Property="Background" Value="{DynamicResource Brush.accent-tint}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.accent-ink}" />
        <Setter Property="FontWeight" Value="{DynamicResource Fw.title}" />
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsMouseOver" Value="True" />
          <Condition Property="IsEnabled" Value="True" />
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource Brush.surface-2}" />
      </MultiTrigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.55" />
        <Setter Property="Cursor" Value="Arrow" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Sort chip: 0.2rem 0.6rem, 1px control-bd, radius-chip, surface, ink-2, 0.82rem; on: accent fill and border, on-accent. -->
  <Style x:Key="SortChip" TargetType="RadioButton" BasedOn="{StaticResource Chip}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.ink-2}" />
    <Setter Property="Padding" Value="9.6,3.2" />
    <Setter Property="FontSize" Value="13.12" />
    <Style.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.on-accent}" />
        <Setter Property="FontWeight" Value="Normal" />
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsMouseOver" Value="True" />
          <Condition Property="IsChecked" Value="False" />
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource Brush.surface}" />
      </MultiTrigger>
    </Style.Triggers>
  </Style>

  <!-- ===== Text input ===== -->

  <!--
    project input: 0.55rem 0.75rem, 1px control-bd, radius-control, 0.95rem; focused: a 2 DIP focus-ring
    outline and an accent border. Fields take field-bg and ink (D-HOME-30): WPF has no UA field colours.
  -->
  <Style x:Key="TextInput" TargetType="TextBox">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Background" Value="{DynamicResource Brush.field-bg}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.ink}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Brush.ink}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Brush.accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.control-bd}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,8.8" />
    <Setter Property="FontSize" Value="15.2" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Grid>
            <Border x:Name="Ring" Margin="-2" BorderThickness="2" BorderBrush="{DynamicResource Brush.focus-ring}"
                    CornerRadius="{DynamicResource Radius.control}" Visibility="Collapsed" />
            <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Radius.control}">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                            HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
              <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Brush.accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.55" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    project__search-clear (06 2.8): inside the search box, transparent, ink-3, 0.85rem, line-height 1,
    padding 0.25rem, radius-control-sm; hover ink on control-bd.
  -->
  <Style x:Key="Search.Clear" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.ink-3}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="FontSize" Value="13.6" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource Radius.control-sm}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              TextBlock.LineStackingStrategy="BlockLineHeight" TextBlock.LineHeight="13.6" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource Brush.ink}" />
        <Setter Property="Background" Value="{DynamicResource Brush.control-bd}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===== Settings ===== -->

  <!--
    settings switch: a 38 x 22 track, radius-chip, control-bd, checked accent; an 18 DIP surface knob
    at 2, checked at 18, shadow 0 1px 2px rgba(0, 0, 0, 0.25). The 0.15 s transitions join with the
    Settings view (WP-B10).
  -->
  <Style x:Key="Switch" TargetType="CheckBox">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Width="38" Height="22" Background="Transparent">
            <Border x:Name="Track" Background="{DynamicResource Brush.control-bd}" Tag="{DynamicResource RadiusValue.chip}">
              <Border.CornerRadius>
                <MultiBinding Converter="{StaticResource CapsuleCornerConverter}">
                  <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                  <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                </MultiBinding>
              </Border.CornerRadius>
            </Border>
            <Ellipse x:Name="Knob" Width="18" Height="18" Margin="2" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Fill="{DynamicResource Brush.surface}">
              <Ellipse.Effect>
                <DropShadowEffect Color="{StaticResource FixedColors.KnobShadow}" Opacity="0.25" ShadowDepth="1" Direction="270" BlurRadius="2" />
              </Ellipse.Effect>
            </Ellipse>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.accent}" />
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.55" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- settings group: the card of every group, 1rem 1.1rem, 1px hair, radius-panel, surface. -->
  <Style x:Key="SettingsGroup" TargetType="Border">
    <Setter Property="Padding" Value="17.6,16" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.hair}" />
    <Setter Property="Background" Value="{DynamicResource Brush.surface}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.panel}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!--
    settings toggle: a card whose whole area toggles its switch, the text on the left and the switch on
    the right, 1rem apart; 0.9rem 1.1rem, 1px hair, radius-panel, surface-2.
  -->
  <Style x:Key="SettingsToggleCard" TargetType="CheckBox">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Background" Value="{DynamicResource Brush.surface-2}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.ink}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.hair}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="17.6,14.4" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Radius.panel}"
                  Padding="{TemplateBinding Padding}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
              <Grid Grid.Column="2" Width="38" Height="22" VerticalAlignment="Center">
                <Border x:Name="Track" Background="{DynamicResource Brush.control-bd}" Tag="{DynamicResource RadiusValue.chip}">
                  <Border.CornerRadius>
                    <MultiBinding Converter="{StaticResource CapsuleCornerConverter}">
                      <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                      <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                    </MultiBinding>
                  </Border.CornerRadius>
                </Border>
                <Ellipse x:Name="Knob" Width="18" Height="18" Margin="2" HorizontalAlignment="Left" VerticalAlignment="Top"
                         Fill="{DynamicResource Brush.surface}">
                  <Ellipse.Effect>
                    <DropShadowEffect Color="{StaticResource FixedColors.KnobShadow}" Opacity="0.25" ShadowDepth="1" Direction="270" BlurRadius="2" />
                  </Ellipse.Effect>
                </Ellipse>
              </Grid>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.accent}" />
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.55" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Badges ===== -->

  <!-- project badge: 0.66rem, 700, 0.1rem 0.5rem, radius-chip, a 0.34rem dot in the text colour 0.3rem before the text. -->
  <Style x:Key="Badge.Base" TargetType="ContentControl">
    <Setter Property="FontSize" Value="10.56" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Padding" Value="8,1.6" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" Tag="{DynamicResource RadiusValue.chip}">
            <Border.CornerRadius>
              <MultiBinding Converter="{StaticResource CapsuleCornerConverter}">
                <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
              </MultiBinding>
            </Border.CornerRadius>
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="5.44" Height="5.44" Margin="0,0,4.8,0" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}" />
              <ContentPresenter VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- SOP ready: ok-ink on ok-tint. -->
  <Style x:Key="Badge.Ok" TargetType="ContentControl" BasedOn="{StaticResource Badge.Base}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.ok-ink}" />
    <Setter Property="Background" Value="{DynamicResource Brush.ok-tint}" />
  </Style>

  <!-- Draft: draft-ink on draft-tint. -->
  <Style x:Key="Badge.Draft" TargetType="ContentControl" BasedOn="{StaticResource Badge.Base}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.draft-ink}" />
    <Setter Property="Background" Value="{DynamicResource Brush.draft-tint}" />
  </Style>

  <!-- ===== Menus and pickers ===== -->

  <!-- menu item: 0.42rem 0.6rem, radius-control-sm, ink, fs-body, no wrap, full width; hover accent-tint; disabled 0.5. -->
  <Style x:Key="MenuItem.Base" TargetType="ButtonBase">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.ink}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="9.6,6.72" />
    <Setter Property="FontSize" Value="{DynamicResource Fs.body}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Radius.control-sm}">
            <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsMouseOver" Value="True" />
          <Condition Property="IsEnabled" Value="True" />
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource Brush.accent-tint}" />
      </MultiTrigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.5" />
        <Setter Property="Cursor" Value="Arrow" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- menu item danger: danger-ink; hover danger-tint. -->
  <Style x:Key="MenuItem.Danger" TargetType="ButtonBase" BasedOn="{StaticResource MenuItem.Base}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.danger-ink}" />
    <Style.Triggers>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsMouseOver" Value="True" />
          <Condition Property="IsEnabled" Value="True" />
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource Brush.danger-tint}" />
      </MultiTrigger>
    </Style.Triggers>
  </Style>

  <!--
    menu header: 0.4rem 0.6rem 0.2rem, 0.72rem, 600, ink-3, label stretch, not selectable. The view
    upper-cases its text with UpperCaseConverter; the 0.03em letter spacing has no WPF property.
  -->
  <Style x:Key="MenuHeader" TargetType="TextBlock">
    <Setter Property="Padding" Value="9.6,6.4,9.6,3.2" />
    <Setter Property="FontSize" Value="11.52" />
    <Setter Property="FontWeight" Value="{DynamicResource Fw.title}" />
    <Setter Property="FontFamily" Value="{DynamicResource Font.label-stack}" />
    <Setter Property="FontStretch" Value="{DynamicResource Font.label-stretch}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.ink-3}" />
  </Style>

  <!--
    picker item: 0.45rem 0.7rem, 1px hair-2 below, transparent, ink, fs-body; hover accent-tint; on:
    accent-tint, 600, and a 3 DIP accent bar inset on the left.
  -->
  <Style x:Key="PickerItem" TargetType="ListBoxItem">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.ink}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.hair-2}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="11.2,7.2" />
    <Setter Property="FontSize" Value="{DynamicResource Fs.body}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <Grid>
              <Rectangle x:Name="Bar" Width="3" HorizontalAlignment="Left" Fill="{DynamicResource Brush.accent}" Visibility="Collapsed" />
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.accent-tint}" />
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.accent-tint}" />
        <Setter Property="FontWeight" Value="{DynamicResource Fw.title}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===== Tabs ===== -->

  <!--
    settings tab: 0.55rem 0.9rem, a 2 DIP bottom border on the container's 1 DIP hair line (margin -1),
    ink-2, fs-body, fw-title; hover ink; on: accent text and border.
  -->
  <Style x:Key="TabUnderline" TargetType="RadioButton">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.ink-2}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="Padding" Value="14.4,8.8" />
    <Setter Property="Margin" Value="0,0,0,-1" />
    <Setter Property="FontSize" Value="{DynamicResource Fs.body}" />
    <Setter Property="FontWeight" Value="{DynamicResource Fw.title}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource Brush.ink}" />
      </Trigger>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource Brush.accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.accent}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!--
    home tab: 0.5rem 0.15rem 0.7rem, fs-title, fw-section, ink-3; on: ink and a 2.5 DIP accent underline
    over the container's hair line, corner 3 (the hairline indicator allowance).
  -->
  <Style x:Key="HomeTab" TargetType="RadioButton">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.ink-3}" />
    <Setter Property="Padding" Value="2.4,8,2.4,11.2" />
    <Setter Property="FontSize" Value="{DynamicResource Fs.title}" />
    <Setter Property="FontWeight" Value="{DynamicResource Fw.section}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="{TemplateBinding Background}">
            <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
            <Border x:Name="Underline" Height="2.5" Margin="0,0,0,-1" VerticalAlignment="Bottom" CornerRadius="3"
                    Background="{DynamicResource Brush.accent}" Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource Brush.ink}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- A home tab's count: 0.7rem, 700, radius-chip, 0.05rem 0.45rem, 0.4rem after the label; ink-3 on hair-2, on its checked tab accent-ink on accent-tint. -->
  <Style x:Key="HomeTabCount" TargetType="Border">
    <Setter Property="Margin" Value="6.4,0,0,0" />
    <Setter Property="Padding" Value="7.2,0.8" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource Brush.hair-2}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.ink-3}" />
    <Setter Property="TextElement.FontSize" Value="11.2" />
    <Setter Property="TextElement.FontWeight" Value="Bold" />
    <Setter Property="Tag" Value="{DynamicResource RadiusValue.chip}" />
    <Setter Property="CornerRadius">
      <Setter.Value>
        <MultiBinding Converter="{StaticResource CapsuleCornerConverter}">
          <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
          <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
        </MultiBinding>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.accent-tint}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.accent-ink}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <!-- ===== Notices ===== -->

  <!--
    A notice (06 2.21, notice.css): its kind's fill at 0.6 alpha, white 0.85rem text with a small
    shadow, and notice.css's own 8 DIP corners and drop shadow, which are not tokens: a notice looks
    the same under every brand and appearance, so XamlChromeGuard exempts the Notice prefix. It
    enters in 140 ms from 6 DIP above, transparent. Its text is a live region, assertive for an
    error (D-HOME-24), announced on each change by LiveRegion, since WPF does not announce one.
  -->
  <Style x:Key="Notice.Dismiss" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource FixedColors.NoticeText}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="2.4,0" />
    <Setter Property="FontSize" Value="18.4" />
    <Setter Property="Opacity" Value="0.8" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <ContentPresenter TextBlock.LineStackingStrategy="BlockLineHeight" TextBlock.LineHeight="18.4" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Opacity" Value="1" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <DataTemplate x:Key="Notice.Template" DataType="{x:Type chrome:NoticeViewModel}">
    <Border x:Name="Card" Margin="0,0,0,6.4" Padding="12.8,8,8,8" CornerRadius="8" Opacity="0"
            Background="{StaticResource FixedColors.NoticeError}" SnapsToDevicePixels="True">
      <Border.RenderTransform>
        <TranslateTransform Y="-6" />
      </Border.RenderTransform>
      <Border.Effect>
        <DropShadowEffect Color="{StaticResource FixedColors.NoticeShadow}" Direction="270" ShadowDepth="6" BlurRadius="20" Opacity="0.25" />
      </Border.Effect>
      <Border.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.14">
                <DoubleAnimation.EasingFunction>
                  <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
              </DoubleAnimation>
              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-6" To="0" Duration="0:0:0.14">
                <DoubleAnimation.EasingFunction>
                  <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
              </DoubleAnimation>
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
      </Border.Triggers>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="NoticeText" Text="{Binding Text}" TextWrapping="Wrap" FontSize="13.6"
                   LineStackingStrategy="BlockLineHeight" LineHeight="18.36" Foreground="{StaticResource FixedColors.NoticeText}"
                   AutomationProperties.LiveSetting="Assertive" chrome:LiveRegion.Text="{Binding Text, RelativeSource={RelativeSource Self}}">
          <TextBlock.Effect>
            <DropShadowEffect Color="{StaticResource FixedColors.NoticeTextShadow}" Direction="270" ShadowDepth="1" BlurRadius="2" Opacity="0.45" />
          </TextBlock.Effect>
        </TextBlock>
        <Button Grid.Column="1" Margin="9.6,0,0,0" VerticalAlignment="Top" Style="{StaticResource Notice.Dismiss}"
                Content="{x:Static corehome:HomeText.NoticeDismiss}" ToolTip="{x:Static corehome:HomeText.NoticeDismissName}"
                AutomationProperties.Name="{x:Static corehome:HomeText.NoticeDismissName}"
                Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                CommandParameter="{Binding}" />
      </Grid>
    </Border>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Kind}" Value="Info">
        <Setter TargetName="Card" Property="Background" Value="{StaticResource FixedColors.NoticeInfo}" />
        <Setter TargetName="NoticeText" Property="AutomationProperties.LiveSetting" Value="Polite" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Kind}" Value="Success">
        <Setter TargetName="Card" Property="Background" Value="{StaticResource FixedColors.NoticeSuccess}" />
        <Setter TargetName="NoticeText" Property="AutomationProperties.LiveSetting" Value="Polite" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
</ResourceDictionary>
