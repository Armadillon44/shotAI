<UserControl x:Class="ShotAI.App.Home.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:home="clr-namespace:ShotAI.App.Home"
             xmlns:chrome="clr-namespace:ShotAI.App.Chrome"
             xmlns:core="clr-namespace:ShotAI.Core.Home;assembly=ShotAI.Core"
             xmlns:capture="clr-namespace:ShotAI.Core.Capture;assembly=ShotAI.Core"
             Focusable="False" IsTabStop="False">
  <!--
    Home (spec 06 2.3, 2.4, 2.7 to 2.12, 2.17): the create hero with the capture-mode picker, the
    tabs, the list head, then the rows under their date spans or search tiers, or the empty state.
    The one scroller of the view, padded as .project__body (1.75rem 2rem); the padding scrolls with
    the content. The shared styles are read with DynamicResource, so the view also loads outside
    the Application (the tests' windows).
  -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <chrome:UpperCaseConverter x:Key="UpperCase" />

    <!-- home__dd-trigger: 0.45rem 0.7rem, 1px control-bd, radius-control, surface, ink, fs-body, left aligned; hover accent border. -->
    <Style x:Key="TargetTrigger" TargetType="home:TargetTrigger">
      <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
      <Setter Property="Background" Value="{DynamicResource Brush.surface}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.ink}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.control-bd}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="11.2,7.2" />
      <Setter Property="FontSize" Value="{DynamicResource Fs.body}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="home:TargetTrigger">
            <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Radius.control}">
              <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 2.11: a span or tier header, upper-cased, with a hairline filling the rest of the line. Text for assistive tech, a level 3 heading (7.13). -->
    <DataTemplate DataType="{x:Type home:GroupHeaderItem}">
      <Grid Margin="2.4,22.4,2.4,5.6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Label, Converter={StaticResource UpperCase}}" FontFamily="{DynamicResource Font.label-stack}"
                   FontStretch="{DynamicResource Font.label-stretch}" FontSize="{DynamicResource Fs.label}" FontWeight="Bold"
                   Foreground="{DynamicResource Brush.ink-3}" AutomationProperties.HeadingLevel="Level3" />
        <Border Grid.Column="1" Height="1" Margin="9.6,0,0,0" VerticalAlignment="Center" Background="{DynamicResource Brush.hair}" />
      </Grid>
    </DataTemplate>

    <!--
      2.12: a row card, 0.5rem below the item above it: the checkbox; the title (with an ellipsis)
      and its badge, or the rename box in their place (2.13); the meta line, Working... while the
      row is busy; Open and the overflow menu. Selected, its border is the accent and its fill the
      tint (the hover's border wins, as :hover outranks the selected class). Hover lifts it 1 DIP.
    -->
    <DataTemplate DataType="{x:Type home:ProjectRowViewModel}">
      <Border x:Name="Card" Margin="0,8,0,0" Padding="14.4,12" BorderThickness="1" SnapsToDevicePixels="True"
              BorderBrush="{DynamicResource Brush.hair}" Background="{DynamicResource Brush.surface}"
              CornerRadius="{DynamicResource Radius.panel}" Effect="{DynamicResource Shadow.sm}">
        <Border.RenderTransform>
          <TranslateTransform />
        </Border.RenderTransform>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <home:RowCheckBox x:Name="Check" Margin="0,0,14.4,0" VerticalAlignment="Center" Style="{DynamicResource RowCheck}"
                            IsChecked="{Binding IsSelected, Mode=OneWay}" AutomationProperties.Name="{Binding SelectName}"
                            Command="{Binding DataContext.ToggleSelectCommand, RelativeSource={RelativeSource AncestorType=home:HomeView}}"
                            CommandParameter="{Binding}" />
          <StackPanel Grid.Column="1" Margin="0,0,14.4,0" VerticalAlignment="Center">
            <Grid x:Name="TitleLine" HorizontalAlignment="Left">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                         FontSize="{DynamicResource Fs.title}" FontWeight="{DynamicResource Fw.title}" />
              <ContentControl x:Name="Badge" Grid.Column="1" Margin="8.8,0,0,0" VerticalAlignment="Center"
                              Style="{DynamicResource Badge.Draft}" Content="{Binding Badge}" ToolTip="{Binding BadgeTitle}" />
            </Grid>
            <TextBox x:Name="RenameBox" Visibility="Collapsed" Style="{DynamicResource RenameInput}"
                     Text="{Binding DataContext.RenameValue, RelativeSource={RelativeSource AncestorType=home:HomeView}, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{x:Static core:HomeText.Rename}"
                     KeyDown="OnRenameKeyDown" LostKeyboardFocus="OnRenameLostFocus" IsVisibleChanged="OnRenameVisibleChanged" />
            <TextBlock Margin="0,2.4,0,0" Text="{Binding Meta}" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource Brush.ink-2}" FontSize="{DynamicResource Fs.meta}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button VerticalAlignment="Center" Style="{DynamicResource Button.SmallPrimary}"
                    Content="{x:Static core:HomeText.Open}" ToolTip="{Binding OpenTitle}"
                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=home:HomeView}}"
                    CommandParameter="{Binding}" />
            <chrome:OverflowMenu x:Name="RowMenu" Margin="6.4,0,0,0" VerticalAlignment="Center" Items="{Binding MenuItems}"
                                 IsEnabled="{Binding DataContext.NotBusy, RelativeSource={RelativeSource AncestorType=home:HomeView}}" />
          </StackPanel>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding HasSop}" Value="True">
          <Setter TargetName="Badge" Property="Style" Value="{DynamicResource Badge.Ok}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsRenaming}" Value="True">
          <Setter TargetName="TitleLine" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="RenameBox" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.accent}" />
          <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.item-selected-bg}" />
        </DataTrigger>
        <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
          <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.item-hover-border}" />
          <Trigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                 To="-1" Duration="0:0:0.16" />
              </Storyboard>
            </BeginStoryboard>
          </Trigger.EnterActions>
          <Trigger.ExitActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                 To="0" Duration="0:0:0.16" />
              </Storyboard>
            </BeginStoryboard>
          </Trigger.ExitActions>
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="32,28">
      <!--
        2.3: the create hero, 1.5rem above the tabs: the heading, the mission (60ch), and the name box
        with Capture and Empty Project, 0.6rem apart. Enter in the name box is Capture's, when it can
        run (7.9); the box's placeholder is a TextBlock over it, and its help text for assistive tech.
      -->
      <StackPanel x:Name="Hero" Margin="0,0,0,24" DataContext="{Binding Hero}">
        <TextBlock Margin="0,0,0,11.2" Text="{x:Static core:HomeText.StartProject}" FontSize="{DynamicResource Fs.section}"
                   FontWeight="{DynamicResource Fw.section}" AutomationProperties.HeadingLevel="Level2" />
        <TextBlock Margin="0,-4.8,0,16" HorizontalAlignment="Left" MaxWidth="472.5" TextWrapping="Wrap" Text="{x:Static core:HomeText.Mission}"
                   FontSize="{DynamicResource Fs.body}" LineStackingStrategy="BlockLineHeight" LineHeight="21" Foreground="{DynamicResource Brush.ink-2}" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="NameBox" Style="{DynamicResource TextInput}" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                   IsEnabled="{Binding CanEditName}" AutomationProperties.Name="{x:Static core:HomeText.NameBoxName}"
                   AutomationProperties.HelpText="{x:Static core:HomeText.NamePlaceholder}">
            <TextBox.InputBindings>
              <KeyBinding Key="Enter" Command="{Binding CaptureCommand}" />
            </TextBox.InputBindings>
          </TextBox>
          <TextBlock Margin="13,0,13,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="15.2" TextTrimming="CharacterEllipsis"
                     Text="{x:Static core:HomeText.NamePlaceholder}" Foreground="{DynamicResource Brush.ink-3}"
                     Visibility="{Binding ShowNamePlaceholder, Converter={StaticResource Visible}}" />
          <Button x:Name="CaptureButton" Grid.Column="1" Margin="9.6,0,0,0" Style="{DynamicResource Button.Primary}" Content="{Binding CaptureText}"
                  ToolTip="{x:Static core:HomeText.CaptureButtonTitle}" ToolTipService.ShowOnDisabled="True" Command="{Binding CaptureCommand}" />
          <Button x:Name="EmptyProjectButton" Grid.Column="2" Margin="9.6,0,0,0" Style="{DynamicResource Button.Ghost}"
                  Content="{x:Static core:HomeText.EmptyProject}" ToolTip="{x:Static core:HomeText.EmptyProjectTitle}" ToolTipService.ShowOnDisabled="True"
                  Command="{Binding EmptyProjectCommand}" />
        </Grid>

        <!--
          2.4: the mode chips, one radio group (the arrows move between them, 7.9), after the Mode
          label and before Auto's warning, 0.4rem apart; then the plain-language hint (62ch), and the
          target dropdown's trigger, the Area button or a warning, as the mode needs.
        -->
        <StackPanel DataContext="{Binding Mode}">
          <WrapPanel x:Name="ModeRow" Margin="0,11.2,0,0" AutomationProperties.Name="{x:Static core:HomeText.ModeGroupName}">
            <TextBlock Margin="0,0,8.8,0" VerticalAlignment="Center" Text="{Binding Source={x:Static core:HomeText.ModeLabel}, Converter={StaticResource UpperCase}}"
                       FontFamily="{DynamicResource Font.label-stack}" FontStretch="{DynamicResource Font.label-stretch}" FontSize="{DynamicResource Fs.label}"
                       Foreground="{DynamicResource Brush.ink-3}" />
            <RadioButton x:Name="ScreenChip" Margin="0,0,6.4,0" GroupName="CaptureMode" Style="{DynamicResource Chip}" IsChecked="{Binding IsScreen}"
                         Content="{x:Static core:HomeText.ModeScreen}" ToolTip="{x:Static core:HomeText.ModeScreenHint}"
                         Command="{Binding SelectModeCommand}" CommandParameter="{x:Static capture:CaptureMode.Screen}" />
            <RadioButton x:Name="AutoChip" Margin="0,0,6.4,0" GroupName="CaptureMode" Style="{DynamicResource Chip}" IsChecked="{Binding IsAuto}"
                         Content="{x:Static core:HomeText.ModeAuto}" ToolTip="{x:Static core:HomeText.ModeAutoHint}"
                         Command="{Binding SelectModeCommand}" CommandParameter="{x:Static capture:CaptureMode.Auto}" />
            <RadioButton x:Name="WindowChip" Margin="0,0,6.4,0" GroupName="CaptureMode" Style="{DynamicResource Chip}" IsChecked="{Binding IsWindow}"
                         Content="{x:Static core:HomeText.ModeWindow}" ToolTip="{x:Static core:HomeText.ModeWindowHint}"
                         Command="{Binding SelectModeCommand}" CommandParameter="{x:Static capture:CaptureMode.Window}" />
            <RadioButton x:Name="AreaChip" Margin="0,0,6.4,0" GroupName="CaptureMode" Style="{DynamicResource Chip}" IsChecked="{Binding IsArea}"
                         Content="{x:Static core:HomeText.ModeArea}" ToolTip="{x:Static core:HomeText.ModeAreaHint}"
                         Command="{Binding SelectModeCommand}" CommandParameter="{x:Static capture:CaptureMode.Area}" />
            <TextBlock x:Name="AutoWarning" VerticalAlignment="Center" Text="{x:Static core:HomeText.AutoWarning}" ToolTip="{x:Static core:HomeText.AutoWarningTitle}"
                       Cursor="Help" FontSize="{DynamicResource Fs.meta}" Foreground="{DynamicResource Brush.caut-fg}"
                       Visibility="{Binding ShowsAutoWarning, Converter={StaticResource Visible}}" />
          </WrapPanel>
          <TextBlock x:Name="ModeHint" Margin="0,8,0,0" HorizontalAlignment="Left" MaxWidth="446.4" TextWrapping="Wrap" FontSize="{DynamicResource Fs.meta}"
                     LineStackingStrategy="BlockLineHeight" LineHeight="18.56" Foreground="{DynamicResource Brush.ink-3}"><Run Text="{x:Static core:HomeText.ModeHintBefore}" /><Run Text="{x:Static core:HomeText.ModeScreen}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.ink-2}" /><Run Text="{x:Static core:HomeText.ModeHintAfterScreen}" /><Run Text="{x:Static core:HomeText.ModeWindow}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.ink-2}" /><Run Text="{x:Static core:HomeText.ModeHintAfterWindow}" /><Run Text="{x:Static core:HomeText.ModeArea}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.ink-2}" /><Run Text="{x:Static core:HomeText.ModeHintAfterArea}" /><Run Text="{x:Static core:HomeText.ModeAuto}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.ink-2}" /><Run Text="{x:Static core:HomeText.ModeHintAfterAuto}" /></TextBlock>

          <!-- home__dd: min 280, max 460, 0.6rem down; the label with an ellipsis and the caret. The popover is the shell's (TargetDropdownView). -->
          <home:TargetTrigger x:Name="TargetTrigger" Margin="0,9.6,0,0" HorizontalAlignment="Left" MinWidth="280" MaxWidth="460" Style="{StaticResource TargetTrigger}"
                              IsOpen="{Binding PickerOpen, Mode=OneWay}" Command="{Binding ToggleDropdownCommand}" AutomationProperties.Name="{Binding TriggerLabel}"
                              Visibility="{Binding ShowsDropdown, Converter={StaticResource Visible}}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Margin="9.6,0,0,0" VerticalAlignment="Center" Text="{x:Static core:HomeText.DropdownCaret}"
                         Foreground="{DynamicResource Brush.ink-3}" />
              <TextBlock VerticalAlignment="Center" Text="{Binding TriggerLabel}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
          </home:TargetTrigger>

          <!-- capmode__picker: the Area button and the area beside it, 0.5rem apart. -->
          <StackPanel Margin="0,11.2,0,0" Orientation="Horizontal" Visibility="{Binding ShowsAreaPicker, Converter={StaticResource Visible}}">
            <Button x:Name="AreaButton" Style="{DynamicResource Button.Base}" Content="{Binding AreaButtonText}" Command="{Binding SelectAreaCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
            <TextBlock x:Name="AreaText" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding AreaText}" FontSize="13.6"
                       Foreground="{DynamicResource Brush.accent-ink}" Typography.NumeralAlignment="Tabular"
                       Visibility="{Binding HasArea, Converter={StaticResource Visible}}" />
          </StackPanel>

          <!-- capmode__warn: why Capture is disabled, in the caution colour. -->
          <TextBlock x:Name="WindowWarning" Margin="0,8,0,0" TextWrapping="Wrap" Text="{x:Static core:HomeText.WindowWarning}" FontSize="13.12"
                     Foreground="{DynamicResource Brush.caut-fg}" Visibility="{Binding ShowsWindowWarning, Converter={StaticResource Visible}}" />
          <TextBlock x:Name="AreaWarning" Margin="0,8,0,0" TextWrapping="Wrap" Text="{x:Static core:HomeText.AreaWarning}" FontSize="13.12"
                     Foreground="{DynamicResource Brush.caut-fg}" Visibility="{Binding ShowsAreaWarning, Converter={StaticResource Visible}}" />
        </StackPanel>
      </StackPanel>

      <!-- 2.7: the tabs, a pair of radio buttons over a hairline; the counts are over every project. -->
      <Border Margin="0,0,0,4" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.hair}">
        <StackPanel Orientation="Horizontal" AutomationProperties.Name="{x:Static core:HomeText.TabsName}"
                    KeyboardNavigation.DirectionalNavigation="Cycle">
          <RadioButton x:Name="ActiveTab" Margin="0,0,20,0" GroupName="HomeTabs" Style="{DynamicResource HomeTab}"
                       IsChecked="{Binding IsActiveTab}" AutomationProperties.Name="{Binding ActiveTabName}">
            <StackPanel Orientation="Horizontal">
              <TextBlock VerticalAlignment="Center" Text="{x:Static core:HomeText.ProjectsTab}" />
              <Border Style="{DynamicResource HomeTabCount}">
                <TextBlock Text="{Binding ActiveCount}" />
              </Border>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="ArchiveTab" GroupName="HomeTabs" Style="{DynamicResource HomeTab}"
                       IsChecked="{Binding IsArchiveTab}" AutomationProperties.Name="{Binding ArchiveTabName}">
            <StackPanel Orientation="Horizontal">
              <TextBlock VerticalAlignment="Center" Text="{x:Static core:HomeText.ArchiveTab}" />
              <Border Style="{DynamicResource HomeTabCount}">
                <TextBlock Text="{Binding ArchiveCount}" />
              </Border>
            </StackPanel>
          </RadioButton>
        </StackPanel>
      </Border>

      <!--
        2.8: the heading with its count and the Import button, the search box (from 200 DIP, growing
        to 340), and the sort group, wrapping as the CSS flex row does. The heading's bottom margin
        extends its line as the h2's does.
      -->
      <chrome:FlexWrapPanel Gap="16">
        <StackPanel Margin="0,0,0,11.2" Orientation="Horizontal" VerticalAlignment="Top">
          <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource Fs.section}" FontWeight="{DynamicResource Fw.section}"
                     AutomationProperties.HeadingLevel="Level2"><Run Text="{Binding Heading, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding HeadingCount, Mode=OneWay}" FontSize="{DynamicResource Fs.meta}" FontWeight="Normal" Foreground="{DynamicResource Brush.ink-3}" /></TextBlock>
          <Button Margin="13.6,0,0,0" VerticalAlignment="Center" Style="{DynamicResource Button.SmallGhost}"
                  Content="{x:Static core:HomeText.ImportButton}" ToolTip="{x:Static core:HomeText.ImportButtonTitle}"
                  Command="{Binding ImportCommand}" Visibility="{Binding ImportVisible, Converter={StaticResource Visible}}" />
        </StackPanel>
        <Grid chrome:FlexWrapPanel.Basis="200" chrome:FlexWrapPanel.Grow="1" MaxWidth="340" VerticalAlignment="Center">
          <TextBox x:Name="Search" Style="{DynamicResource TextInput}" Padding="12,8.8,32,8.8"
                   Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="{x:Static core:HomeText.SearchName}"
                   AutomationProperties.HelpText="{x:Static core:HomeText.SearchPlaceholder}">
            <TextBox.InputBindings>
              <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
            </TextBox.InputBindings>
          </TextBox>
          <TextBlock Margin="13,0,32,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="15.2"
                     Text="{x:Static core:HomeText.SearchPlaceholder}" Foreground="{DynamicResource Brush.ink-3}"
                     Visibility="{Binding ShowPlaceholder, Converter={StaticResource Visible}}" />
          <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6.4,0" Style="{DynamicResource Search.Clear}"
                  Content="{x:Static core:HomeText.SearchClear}" ToolTip="{x:Static core:HomeText.SearchClearName}"
                  AutomationProperties.Name="{x:Static core:HomeText.SearchClearName}" Command="{Binding ClearSearchCommand}"
                  Visibility="{Binding HasQuery, Converter={StaticResource Visible}}" />
        </Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" AutomationProperties.Name="{x:Static core:HomeText.SortGroupName}">
          <TextBlock VerticalAlignment="Center" Text="{x:Static core:HomeText.SortLabel}" FontSize="13.6" Foreground="{DynamicResource Brush.ink-2}" />
          <RadioButton Margin="4.8,0,0,0" GroupName="HomeSort" Style="{DynamicResource SortChip}"
                       Content="{x:Static core:HomeText.SortName}" IsChecked="{Binding SortByName}" />
          <RadioButton Margin="4.8,0,0,0" GroupName="HomeSort" Style="{DynamicResource SortChip}"
                       Content="{x:Static core:HomeText.SortCreated}" IsChecked="{Binding SortByCreated}" />
          <RadioButton Margin="4.8,0,0,0" GroupName="HomeSort" Style="{DynamicResource SortChip}"
                       Content="{x:Static core:HomeText.SortModified}" IsChecked="{Binding SortByModified}" />
          <ToggleButton Margin="4.8,0,0,0" Style="{DynamicResource Button.Small}" IsChecked="{Binding SortAscending}"
                        Content="{Binding SortDirectionGlyph}" ToolTip="{Binding SortDirectionTitle}"
                        AutomationProperties.Name="{x:Static core:HomeText.SortDirectionName}"
                        AutomationProperties.HelpText="{Binding SortDirectionTitle}" />
        </StackPanel>
      </chrome:FlexWrapPanel>

      <!--
        2.16: the bulk bar, while rows are selected or a bulk run goes: the select-all toggle and the
        count (a polite live region), and on the right the archive or restore, delete and Clear.
        The export menu joins with Home export (WP-D16).
      -->
      <Border x:Name="BulkBar" Margin="0,5.6,0,12" Padding="11.2,8.8" BorderThickness="1" SnapsToDevicePixels="True"
              BorderBrush="{DynamicResource Brush.bulk-border}" Background="{DynamicResource Brush.accent-tint}"
              CornerRadius="{DynamicResource Radius.control}" DataContext="{Binding Bulk}"
              Visibility="{Binding IsVisible, Converter={StaticResource Visible}}"
              AutomationProperties.Name="{x:Static core:HomeText.BulkName}">
        <chrome:FlexWrapPanel Gap="9.6">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <ToggleButton x:Name="BulkToggle" VerticalAlignment="Center" Style="{DynamicResource BulkToggle}"
                          IsChecked="{Binding AllSelected, Mode=OneWay}" Content="{Binding ToggleAllText}" Command="{Binding ToggleAllCommand}" />
            <TextBlock x:Name="BulkCount" Margin="9.6,0,0,0" VerticalAlignment="Center" Text="{Binding CountText}"
                       FontSize="{DynamicResource Fs.meta}" FontWeight="650" Foreground="{DynamicResource Brush.accent-ink}"
                       AutomationProperties.LiveSetting="Polite" chrome:LiveRegion.Text="{Binding Text, RelativeSource={RelativeSource Self}}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="BulkArchive" Style="{DynamicResource Button.Small}" Content="{Binding ArchiveOrRestoreText}"
                    Command="{Binding ArchiveOrRestoreCommand}" />
            <Button x:Name="BulkDelete" Margin="9.6,0,0,0" Style="{DynamicResource Button.SmallDanger}" Content="{x:Static core:HomeText.BulkDelete}"
                    Command="{Binding DeleteCommand}" />
            <Button x:Name="BulkClear" Margin="9.6,0,0,0" Style="{DynamicResource Button.SmallGhost}" Content="{x:Static core:HomeText.BulkClear}"
                    Command="{Binding ClearCommand}" />
          </StackPanel>
        </chrome:FlexWrapPanel>
      </Border>

      <!-- 2.17: the empty states, centred, 0.5rem below the list head. -->
      <StackPanel Margin="16,48,16,40" HorizontalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
        <TextBlock HorizontalAlignment="Center" FontSize="32" Opacity="0.75" Text="{Binding EmptyIcon}" />
        <TextBlock Margin="0,8,0,3.2" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Text="{Binding EmptyLine}"
                   FontSize="{DynamicResource Fs.title}" FontWeight="{DynamicResource Fw.title}" Foreground="{DynamicResource Brush.ink}" />
        <TextBlock MaxWidth="305" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Text="{Binding EmptySub}"
                   FontSize="{DynamicResource Fs.meta}" Foreground="{DynamicResource Brush.ink-2}"
                   Visibility="{Binding EmptySubIsPlain, Converter={StaticResource Visible}}" />
        <TextBlock MaxWidth="305" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                   FontSize="{DynamicResource Fs.meta}" Foreground="{DynamicResource Brush.ink-2}"
                   Visibility="{Binding EmptySubHasActions, Converter={StaticResource Visible}}"><Run Text="{x:Static core:HomeText.NoProjectsSubBefore}" /><Bold><Run Text="{x:Static core:HomeText.NoProjectsSubCapture}" /></Bold><Run Text="{x:Static core:HomeText.NoProjectsSubMiddle}" /><Bold><Run Text="{x:Static core:HomeText.NoProjectsSubEmpty}" /></Bold><Run Text="{x:Static core:HomeText.NoProjectsSubAfter}" /></TextBlock>
      </StackPanel>

      <!-- 2.9 to 2.12: the rows, under their headers, in render order. -->
      <ItemsControl x:Name="Rows" ItemsSource="{Binding Items}" Focusable="False" IsTabStop="False" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
