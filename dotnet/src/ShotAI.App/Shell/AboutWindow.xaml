<shell:ShotAIWindow x:Class="ShotAI.App.Shell.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:ShotAI.App.Shell"
        xmlns:core="clr-namespace:ShotAI.Core.Shell;assembly=ShotAI.Core"
        Title="{x:Static core:ShellStrings.AboutTitle}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        Background="{DynamicResource Brush.surface}"
        Foreground="{DynamicResource Brush.ink}"
        FontFamily="{DynamicResource Font.stack}"
        FontSize="{DynamicResource Fs.body}">
  <!--
    Spec 03 2.8.4 and 7.4.5: Electron's message box as a registered dialog: the 64 x 64 icon, the
    message in bold, the detail selectable, and one OK button that Enter and Esc both press.
  -->
  <Grid Margin="24,20">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Image x:Name="AppIcon" Source="/shotAI;component/Assets/shotAI_icon.ico" Width="64" Height="64" VerticalAlignment="Top" />
    <StackPanel Grid.Column="1" Margin="16,0,0,0" MaxWidth="400">
      <TextBlock x:Name="MessageText" FontWeight="Bold" FontSize="{DynamicResource Fs.title}" TextWrapping="Wrap" />
      <TextBox x:Name="DetailText" Margin="0,8,0,0" Padding="0" IsReadOnly="True" BorderThickness="0" Background="Transparent"
               Foreground="{DynamicResource Brush.ink}" TextWrapping="Wrap" />
    </StackPanel>
    <Button x:Name="OkButton" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,20,0,0" MinWidth="88" HorizontalAlignment="Right"
            Content="{x:Static core:ShellStrings.Ok}" IsDefault="True" IsCancel="True" Style="{DynamicResource Button.Primary}" />
  </Grid>
</shell:ShotAIWindow>
