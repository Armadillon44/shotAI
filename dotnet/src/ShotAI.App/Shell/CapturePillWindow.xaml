<shell:ShotAIWindow x:Class="ShotAI.App.Shell.CapturePillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:ShotAI.App.Shell"
        xmlns:chrome="clr-namespace:ShotAI.App.Chrome"
        xmlns:core="clr-namespace:ShotAI.Core.Shell;assembly=ShotAI.Core"
        xmlns:capture="clr-namespace:ShotAI.Core.Capture;assembly=ShotAI.Core"
        Title="{x:Static core:ShellStrings.PillTitle}"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        Width="{x:Static core:ShellConstants.PillWidth}"
        Height="{x:Static core:ShellConstants.PillHeight}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Background="{DynamicResource Pill.Background}">
  <!--
    Spec 03 2.4 and 7.4.3: Electron's toolbar page as a non-activating window. The colours,
    corners and sizes are toolbar.css's own (2.4.8), not theme tokens: the pill looks the same
    under every brand and appearance, as the toolbar page did. No control takes the focus, so WPF
    never calls SetFocus into the window, which would activate it (7.6.2).
  -->
  <Window.Resources>
    <SolidColorBrush x:Key="Pill.Background" Color="#FF1F2330" />
    <SolidColorBrush x:Key="Pill.Text" Color="#FFF4F5F7" />
    <SolidColorBrush x:Key="Pill.Accent" Color="#FF4F46E5" />
    <SolidColorBrush x:Key="Pill.AccentPress" Color="#FF4338CA" />
    <SolidColorBrush x:Key="Pill.Error" Color="#FFEF4444" />
    <SolidColorBrush x:Key="Pill.Live" Color="#FF34D399" />
    <SolidColorBrush x:Key="Pill.Paused" Color="#FFFCD34D" />
    <SolidColorBrush x:Key="Pill.ButtonFace" Color="#FF2C3142" />
    <SolidColorBrush x:Key="Pill.ButtonHover" Color="#FF3A4159" />
    <SolidColorBrush x:Key="Pill.DiscardText" Color="#FFFCA5A5" />
    <SolidColorBrush x:Key="Pill.Danger" Color="#FF7F1D1D" />
    <SolidColorBrush x:Key="Pill.DangerHover" Color="#FF991B1B" />
    <SolidColorBrush x:Key="Pill.ErrorText" Color="#FFFECACA" />
    <SolidColorBrush x:Key="Pill.HintInk" Color="#FFAEB4C7" />
    <SolidColorBrush x:Key="Pill.Grip" Color="#FF6B7280" />
    <SolidColorBrush x:Key="Pill.White" Color="#FFFFFFFF" />
    <BooleanToVisibilityConverter x:Key="Pill.Visible" />
    <FontFamily x:Key="Pill.Font">Segoe UI</FontFamily>

    <!-- .toolbar__btn (toolbar.css:214-235): 28 high, radius 7, no focus, the hover skipped while disabled. -->
    <Style x:Key="Pill.Button" TargetType="Button">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinWidth" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="11.52" />
      <Setter Property="Foreground" Value="{StaticResource Pill.Text}" />
      <Setter Property="Background" Value="{StaticResource Pill.ButtonFace}" />
      <Setter Property="Tag" Value="{StaticResource Pill.ButtonHover}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="ToolTipService.InitialShowDelay" Value="{x:Static core:ShellConstants.PillTooltipDelayMs}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
            </Border>
            <ControlTemplate.Triggers>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsMouseOver" Value="True" />
                  <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Face" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
              </MultiTrigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The labeled buttons (toolbar.css:238-243): width from the text, padding 0 9.6, semibold. -->
    <Style x:Key="Pill.LabelButton" TargetType="Button" BasedOn="{StaticResource Pill.Button}">
      <Setter Property="Padding" Value="9.6,0" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Stop (toolbar.css:247-253): the accent, the pressed accent on hover. -->
    <Style x:Key="Pill.StopButton" TargetType="Button" BasedOn="{StaticResource Pill.LabelButton}">
      <Setter Property="Background" Value="{StaticResource Pill.Accent}" />
      <Setter Property="Tag" Value="{StaticResource Pill.AccentPress}" />
    </Style>

    <!-- Discard (toolbar.css:263-270): 28 square, red text; dark red with white text on hover. -->
    <Style x:Key="Pill.DiscardButton" TargetType="Button" BasedOn="{StaticResource Pill.Button}">
      <Setter Property="Width" Value="28" />
      <Setter Property="Foreground" Value="{StaticResource Pill.DiscardText}" />
      <Setter Property="Tag" Value="{StaticResource Pill.Danger}" />
      <Style.Triggers>
        <MultiTrigger>
          <MultiTrigger.Conditions>
            <Condition Property="IsMouseOver" Value="True" />
            <Condition Property="IsEnabled" Value="True" />
          </MultiTrigger.Conditions>
          <Setter Property="Foreground" Value="{StaticResource Pill.White}" />
        </MultiTrigger>
      </Style.Triggers>
    </Style>

    <!-- .toolbar__err-dismiss (toolbar.css:111-132): 18 high, radius 5, worded so it cannot pass for Discard. -->
    <Style x:Key="Pill.DismissButton" TargetType="Button" BasedOn="{StaticResource Pill.Button}">
      <Setter Property="Height" Value="18" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="7.2,0" />
      <Setter Property="FontSize" Value="10.56" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Background" Value="{StaticResource Pill.Danger}" />
      <Setter Property="Foreground" Value="{StaticResource Pill.ErrorText}" />
      <Setter Property="Tag" Value="{StaticResource Pill.DangerHover}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
            </Border>
            <ControlTemplate.Triggers>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsMouseOver" Value="True" />
                  <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Face" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                <Setter Property="Foreground" Value="{StaticResource Pill.White}" />
              </MultiTrigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- .toolbar__label: 13.6 semibold; amber while paused. -->
    <Style x:Key="Pill.Label" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13.6" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{StaticResource Pill.Text}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding View.Status}" Value="{x:Static capture:CaptureStatus.Paused}">
          <Setter Property="Foreground" Value="{StaticResource Pill.Paused}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- .toolbar__rec-dot: 9 x 9, green while recording, amber while paused. -->
    <Style x:Key="Pill.RecDot" TargetType="Ellipse">
      <Setter Property="Width" Value="9" />
      <Setter Property="Height" Value="9" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Fill" Value="{StaticResource Pill.Live}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding View.Status}" Value="{x:Static capture:CaptureStatus.Paused}">
          <Setter Property="Fill" Value="{StaticResource Pill.Paused}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- .toolbar__hint: 11.52, grey or amber, one line with an ellipsis. -->
    <Style x:Key="Pill.Hint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.52" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Padding" Value="5.6,0,0,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Pill.HintInk}" />
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding View.Status}" Value="{x:Static capture:CaptureStatus.Paused}">
          <Setter Property="Foreground" Value="{StaticResource Pill.Paused}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding View.Row2}" Value="{x:Static core:PillStatusRow.Hint}">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- .toolbar__err: red text, semibold, shown in row 2's place while an error stands. -->
    <Style x:Key="Pill.ErrorRow" TargetType="Grid">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Margin" Value="5.6,0,0,0" />
      <Setter Property="TextElement.Foreground" Value="{StaticResource Pill.ErrorText}" />
      <Setter Property="TextElement.FontSize" Value="11.52" />
      <Setter Property="TextElement.FontWeight" Value="SemiBold" />
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding View.Row2}" Value="{x:Static core:PillStatusRow.Error}">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- The inset top bar while recording or paused, red with an error (toolbar.css:285-295). -->
    <Style x:Key="Pill.AccentBar" TargetType="Rectangle">
      <Setter Property="Height" Value="2" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Fill" Value="{StaticResource Pill.Accent}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding View.AccentIsError}" Value="True">
          <Setter Property="Fill" Value="{StaticResource Pill.Error}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- .toolbar__flash: the ring over the whole pill, invisible between flashes. -->
    <Style x:Key="Pill.FlashRing" TargetType="Border">
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="BorderBrush" Value="{StaticResource Pill.Live}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Opacity" Value="0" />
    </Style>
  </Window.Resources>

  <Grid TextElement.FontFamily="{StaticResource Pill.Font}" TextElement.Foreground="{StaticResource Pill.Text}">
    <Rectangle x:Name="AccentBar" Style="{StaticResource Pill.AccentBar}"
               Visibility="{Binding View.AccentBar, Converter={StaticResource Pill.Visible}}" />
    <StackPanel Margin="9.6,4.8" VerticalAlignment="Center">
      <Grid x:Name="Row1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <!-- .toolbar__drag: the grip and the label, where the pill is dragged from. -->
        <Border x:Name="DragArea" Background="Transparent" Padding="4,0,0,0" MinHeight="28" ToolTip="{x:Static core:ShellStrings.DragTip}"
                ToolTipService.InitialShowDelay="{x:Static core:ShellConstants.PillTooltipDelayMs}">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Canvas x:Name="Grip" Width="10" Height="14" Opacity="0.8" VerticalAlignment="Center">
              <Ellipse Canvas.Left="1" Canvas.Top="1" Width="2" Height="2" Fill="{StaticResource Pill.Grip}" />
              <Ellipse Canvas.Left="5" Canvas.Top="1" Width="2" Height="2" Fill="{StaticResource Pill.Grip}" />
              <Ellipse Canvas.Left="1" Canvas.Top="5" Width="2" Height="2" Fill="{StaticResource Pill.Grip}" />
              <Ellipse Canvas.Left="5" Canvas.Top="5" Width="2" Height="2" Fill="{StaticResource Pill.Grip}" />
              <Ellipse Canvas.Left="1" Canvas.Top="9" Width="2" Height="2" Fill="{StaticResource Pill.Grip}" />
              <Ellipse Canvas.Left="5" Canvas.Top="9" Width="2" Height="2" Fill="{StaticResource Pill.Grip}" />
            </Canvas>
            <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
              <Ellipse x:Name="RecDot" Style="{StaticResource Pill.RecDot}"
                       Visibility="{Binding View.ShowRecDot, Converter={StaticResource Pill.Visible}}" />
              <TextBlock x:Name="Label" Style="{StaticResource Pill.Label}" Text="{Binding View.Label}" />
            </StackPanel>
          </StackPanel>
        </Border>
        <!-- .toolbar__controls: never a drag area. -->
        <StackPanel x:Name="Controls" Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0"
                    Visibility="{Binding View.ShowControls, Converter={StaticResource Pill.Visible}}">
          <Button x:Name="PauseButton" Style="{StaticResource Pill.LabelButton}" Content="{x:Static core:ShellStrings.Pause}"
                  ToolTip="{x:Static core:ShellStrings.PauseTip}" AutomationProperties.Name="{x:Static core:ShellStrings.Pause}"
                  Command="{Binding PauseCommand}" Visibility="{Binding View.ShowPause, Converter={StaticResource Pill.Visible}}" />
          <Button x:Name="ResumeButton" Style="{StaticResource Pill.LabelButton}" Content="{x:Static core:ShellStrings.Resume}"
                  ToolTip="{x:Static core:ShellStrings.ResumeTip}" AutomationProperties.Name="{x:Static core:ShellStrings.Resume}"
                  Command="{Binding ResumeCommand}" Visibility="{Binding View.ShowResume, Converter={StaticResource Pill.Visible}}" />
          <Button x:Name="StopButton" Style="{StaticResource Pill.StopButton}" Margin="5.6,0,0,0" Content="{x:Static core:ShellStrings.Stop}"
                  ToolTip="{x:Static core:ShellStrings.StopTip}" AutomationProperties.Name="{x:Static core:ShellStrings.Stop}"
                  Command="{Binding StopCommand}" />
          <Rectangle x:Name="Divider" Width="1" Height="16" Margin="7.2,0" Fill="{StaticResource Pill.ButtonHover}" VerticalAlignment="Center" />
          <Button x:Name="DiscardButton" Style="{StaticResource Pill.DiscardButton}" Content="{x:Static core:ShellStrings.Discard}"
                  ToolTip="{x:Static core:ShellStrings.DiscardTip}" AutomationProperties.Name="{x:Static core:ShellStrings.DiscardTip}"
                  Command="{Binding DiscardCommand}" />
        </StackPanel>
      </Grid>
      <!-- Row 2: the hint, or the error in its place (2.4.5). Only while a session exists. -->
      <Grid x:Name="Row2" Margin="0,2.4,0,0">
        <TextBlock x:Name="HintText" Style="{StaticResource Pill.Hint}" Text="{Binding View.Hint}" />
        <Grid x:Name="ErrorRow" Style="{StaticResource Pill.ErrorRow}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="ErrorGlyph" Text="{x:Static core:ShellStrings.ErrorGlyph}" VerticalAlignment="Center" Cursor="Help"
                     ToolTip="{Binding View.Error}" ToolTipService.InitialShowDelay="{x:Static core:ShellConstants.PillTooltipDelayMs}" />
          <TextBlock x:Name="ErrorMessage" Grid.Column="1" Margin="5.6,0,0,0" Text="{Binding View.Error}" VerticalAlignment="Center"
                     TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Cursor="Help"
                     ToolTip="{Binding View.Error}" ToolTipService.InitialShowDelay="{x:Static core:ShellConstants.PillTooltipDelayMs}"
                     AutomationProperties.LiveSetting="Assertive"
                     chrome:LiveRegion.Text="{Binding Text, RelativeSource={RelativeSource Self}}" />
          <Button x:Name="DismissButton" Grid.Column="2" Margin="5.6,0,0,0" Style="{StaticResource Pill.DismissButton}"
                  Content="{x:Static core:ShellStrings.Dismiss}" ToolTip="{x:Static core:ShellStrings.DismissTip}"
                  AutomationProperties.Name="{x:Static core:ShellStrings.DismissName}" Command="{Binding DismissErrorCommand}" />
        </Grid>
      </Grid>
    </StackPanel>
    <Border x:Name="FlashRing" Style="{StaticResource Pill.FlashRing}" />
  </Grid>
</shell:ShotAIWindow>
