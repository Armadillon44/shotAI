<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:report="clr-namespace:ShotAI.App.Report"
                    xmlns:core="clr-namespace:ShotAI.Core.Report;assembly=ShotAI.Core">
  <!--
    The report's cards (spec 05 2.10, 7.9): one template per kind, each the rail (32 DIP), a
    14 DIP gap and the card, 9.6 DIP apart, so a full-width card is the export's card and its
    content the export's image ceiling (INV-REP-9). What Electron draws as text is here; what it
    draws as a control (the caption and body editors, "+ Add" lines, the step menu, the figure's
    zoom controls) joins with the editing packages (WP-C2, WP-C3). Every theme key is a
    DynamicResource read, so the templates load outside the Application (the tests' windows).
  -->
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/shotAI;component/Themes/FixedColors.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <BooleanToVisibilityConverter x:Key="Report.Visible" />

  <!-- The step card (.rep__bodywrap): a 1 DIP hair-2 frame, card corners, surface-2, padding .85rem 1rem less the border. -->
  <Style x:Key="StepCard.Frame" TargetType="Border">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.hair-2}" />
    <Setter Property="Background" Value="{DynamicResource Brush.surface-2}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.card}" />
    <Setter Property="Padding" Value="15,12.6" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- A pre-wrap paragraph: the text as typed, line breaks kept, wrapped at the card's width. -->
  <Style x:Key="StepCard.Text" TargetType="TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
  </Style>

  <!--
    The figure (2.11, 7.10): the wrap (a hair border, figure corners, the surface) clips the image
    to its rounded content box, and the ring and its halo sit over the image, in image space. The
    placeholder is the loading and missing states' box. ReportFigure sizes and places the parts.
  -->
  <ControlTemplate x:Key="ReportFigure.Template" TargetType="report:ReportFigure">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
      <Border x:Name="PART_Wrap" BorderThickness="1" BorderBrush="{DynamicResource Brush.hair}" Background="{DynamicResource Brush.surface}"
              CornerRadius="{DynamicResource Radius.figure}" SnapsToDevicePixels="True" Visibility="Collapsed">
        <Canvas x:Name="PART_Canvas" HorizontalAlignment="Left" VerticalAlignment="Top">
          <Image x:Name="PART_Image" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"
                 AutomationProperties.Name="{Binding Description, RelativeSource={RelativeSource TemplatedParent}}" />
          <Ellipse x:Name="PART_Halo" Width="26" Height="26" StrokeThickness="2" Stroke="{StaticResource FixedColors.MarkerHalo}"
                   IsHitTestVisible="False" Visibility="Collapsed" />
          <Ellipse x:Name="PART_Ring" Width="22" Height="22" StrokeThickness="2.5" IsHitTestVisible="False" Visibility="Collapsed" />
        </Canvas>
      </Border>
      <Border x:Name="PART_Placeholder" BorderThickness="1" BorderBrush="{DynamicResource Brush.hair}" Background="{DynamicResource Brush.surface}"
              CornerRadius="{DynamicResource Radius.figure}" SnapsToDevicePixels="True">
        <Grid Margin="16,0">
          <ProgressBar x:Name="PART_Progress" Width="120" Height="4" VerticalAlignment="Center" IsIndeterminate="True" BorderThickness="0"
                       Foreground="{DynamicResource Brush.accent}" Background="{DynamicResource Brush.hair}"
                       AutomationProperties.Name="{x:Static core:ReportStrings.Loading}" />
          <TextBlock x:Name="PART_Missing" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                     Foreground="{DynamicResource Brush.ink-3}" FontSize="13.6" Visibility="Collapsed" />
        </Grid>
      </Border>
    </Grid>
  </ControlTemplate>

  <!--
    A shot (2.10 branch 5): the caption (1rem, 600, its padding hung into the card's margin) or its
    placeholder, the figure, the instructions (1.05rem, 1.6 line height, a 3 DIP accent-soft rule)
    and the window line (0.8rem, ink-3, one line).
  -->
  <DataTemplate x:Key="StepCard.Shot" DataType="{x:Type report:StepCardViewModel}">
    <Grid Margin="0,0,0,9.6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="32" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <report:StepRail />
      <Border Grid.Column="2" Style="{StaticResource StepCard.Frame}">
        <StackPanel>
          <Grid MinHeight="32">
            <TextBlock x:Name="Caption" Margin="-4.8,3.2,0,9.6" Padding="4.8,1.6" VerticalAlignment="Center" Text="{Binding Caption}"
                       Style="{StaticResource StepCard.Text}" FontSize="16" FontWeight="600"
                       Visibility="{Binding HasCaption, Converter={StaticResource Report.Visible}}" />
            <TextBlock x:Name="CaptionEmpty" Margin="-4.8,3.2,0,9.6" Padding="4.8,1.6" VerticalAlignment="Center" Text="{x:Static core:ReportStrings.CaptionEmpty}"
                       FontSize="16" FontWeight="500" FontStyle="Italic" Foreground="{DynamicResource Brush.ink-3}" Visibility="Collapsed" />
          </Grid>
          <report:ReportFigure x:Name="Figure" Template="{StaticResource ReportFigure.Template}" ImageKey="{Binding ImageKey}"
                               Zoom="{Binding Zoom}" PanX="{Binding PanX}" PanY="{Binding PanY}" Marker="{Binding Marker}" Description="{Binding Caption}" />
          <Border Margin="0,10.4,0,0" Padding="12,2.4,0,2.4" BorderThickness="3,0,0,0" BorderBrush="{DynamicResource Brush.accent-soft}"
                  Visibility="{Binding HasBody, Converter={StaticResource Report.Visible}}">
            <TextBlock x:Name="Instructions" Text="{Binding Body}" Style="{StaticResource StepCard.Text}" FontSize="16.8" LineHeight="26.88"
                       Foreground="{DynamicResource Brush.ink}" />
          </Border>
          <TextBlock x:Name="WindowLine" Margin="0,6.4,0,0" Text="{Binding WindowLine}" TextTrimming="CharacterEllipsis" FontSize="12.8"
                     Foreground="{DynamicResource Brush.ink-3}" Visibility="{Binding HasWindowLine, Converter={StaticResource Report.Visible}}" />
        </StackPanel>
      </Border>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding HasCaption}" Value="False">
        <Setter TargetName="CaptionEmpty" Property="Visibility" Value="Visible" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!--
    A plain text step (2.10 branch 4): the heading (1.05rem, 650) or, with none, the body (ink-2,
    1.6 line height) as its first line; the body again below only when both are set.
  -->
  <DataTemplate x:Key="StepCard.PlainText" DataType="{x:Type report:StepCardViewModel}">
    <Grid Margin="0,0,0,9.6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="32" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <report:StepRail />
      <Border Grid.Column="2" Style="{StaticResource StepCard.Frame}">
        <StackPanel>
          <Grid MinHeight="32">
            <TextBlock x:Name="Heading" Margin="0,3.2,0,6.4" VerticalAlignment="Center" Text="{Binding Heading}" Style="{StaticResource StepCard.Text}"
                       FontSize="16.8" FontWeight="650" Visibility="{Binding HasHeading, Converter={StaticResource Report.Visible}}" />
            <TextBlock x:Name="FirstBody" VerticalAlignment="Center" Text="{Binding Body}" Style="{StaticResource StepCard.Text}" LineHeight="25.6"
                       Foreground="{DynamicResource Brush.ink-2}" Visibility="{Binding HasBodyOnly, Converter={StaticResource Report.Visible}}" />
          </Grid>
          <TextBlock x:Name="Body" Text="{Binding Body}" Style="{StaticResource StepCard.Text}" LineHeight="25.6" Foreground="{DynamicResource Brush.ink-2}"
                     Visibility="{Binding HasHeadingAndBody, Converter={StaticResource Report.Visible}}" />
        </StackPanel>
      </Border>
    </Grid>
  </DataTemplate>

  <!--
    A note, caution or warning (2.10 branch 3, the co-* tint): the card in the kind's bg, bd and fg,
    the heading as a strong line, the body at a 1.55 line height, or the empty line.
  -->
  <DataTemplate x:Key="StepCard.Callout" DataType="{x:Type report:StepCardViewModel}">
    <Grid Margin="0,0,0,9.6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="32" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <report:StepRail />
      <Border x:Name="Card" Grid.Column="2" Style="{StaticResource StepCard.Frame}">
        <StackPanel>
          <TextBlock x:Name="Heading" Margin="0,0,0,4" Text="{Binding Heading}" Style="{StaticResource StepCard.Text}" FontWeight="Bold"
                     Visibility="{Binding HasHeading, Converter={StaticResource Report.Visible}}" />
          <TextBlock x:Name="Body" Text="{Binding Body}" Style="{StaticResource StepCard.Text}" LineHeight="24.8"
                     Visibility="{Binding HasBody, Converter={StaticResource Report.Visible}}" />
          <TextBlock x:Name="Empty" Text="{x:Static core:ReportStrings.CalloutEmpty}" Style="{StaticResource StepCard.Text}" LineHeight="24.8"
                     FontStyle="Italic" Opacity="0.7" Visibility="{Binding IsBlank, Converter={StaticResource Report.Visible}}" />
        </StackPanel>
      </Border>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding CalloutKind}" Value="note">
        <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.note-bg}" />
        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.note-bd}" />
        <Setter TargetName="Card" Property="TextElement.Foreground" Value="{DynamicResource Brush.note-fg}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding CalloutKind}" Value="caution">
        <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.caut-bg}" />
        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.caut-bd}" />
        <Setter TargetName="Card" Property="TextElement.Foreground" Value="{DynamicResource Brush.caut-fg}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding CalloutKind}" Value="warning">
        <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.warn-bg}" />
        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.warn-bd}" />
        <Setter TargetName="Card" Property="TextElement.Foreground" Value="{DynamicResource Brush.warn-fg}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!--
    A section (2.10 branch 2, co-section): no frame, 0.4rem of top padding, a hairline rule above
    the heading (1.15rem, 700), then the body (ink-2, 1.55) or, with neither, the empty line.
  -->
  <DataTemplate x:Key="StepCard.Section" DataType="{x:Type report:StepCardViewModel}">
    <Grid Margin="0,0,0,9.6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="32" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <report:StepRail />
      <StackPanel Grid.Column="2" Margin="0,6.4,0,0">
        <Border x:Name="Rule" Height="1" Margin="0,3.2,0,9.6" Background="{DynamicResource Brush.hair}" />
        <TextBlock x:Name="Heading" Margin="0,0,0,5.6" Text="{Binding Heading}" Style="{StaticResource StepCard.Text}" FontSize="18.4" FontWeight="Bold"
                   AutomationProperties.HeadingLevel="Level3" Visibility="{Binding HasHeading, Converter={StaticResource Report.Visible}}" />
        <TextBlock x:Name="Body" Text="{Binding Body}" Style="{StaticResource StepCard.Text}" LineHeight="24.8" Foreground="{DynamicResource Brush.ink-2}"
                   Visibility="{Binding HasBody, Converter={StaticResource Report.Visible}}" />
        <TextBlock x:Name="Empty" Text="{x:Static core:ReportStrings.SectionEmpty}" Style="{StaticResource StepCard.Text}" LineHeight="24.8"
                   Foreground="{DynamicResource Brush.ink-2}" FontStyle="Italic" Opacity="0.7"
                   Visibility="{Binding IsBlank, Converter={StaticResource Report.Visible}}" />
      </StackPanel>
    </Grid>
  </DataTemplate>

  <!--
    A row: the template of its kind, chosen by a trigger rather than a template selector, which
    WPF runs once per container, so a card whose kind changes (a callout conversion, WP-C2) takes
    its new layout.
  -->
  <DataTemplate x:Key="StepCard.Row" DataType="{x:Type report:StepCardViewModel}">
    <ContentControl x:Name="Row" Content="{Binding}" ContentTemplate="{StaticResource StepCard.Shot}" Focusable="False" IsTabStop="False" />
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Kind}" Value="PlainText">
        <Setter TargetName="Row" Property="ContentTemplate" Value="{StaticResource StepCard.PlainText}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Kind}" Value="Callout">
        <Setter TargetName="Row" Property="ContentTemplate" Value="{StaticResource StepCard.Callout}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Kind}" Value="Section">
        <Setter TargetName="Row" Property="ContentTemplate" Value="{StaticResource StepCard.Section}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
</ResourceDictionary>
