<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The WPF app: windows, views, view models and the composition root. Keeps the
    executable name shotAI.exe, the same as the Electron build.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(ShotAIWindowsTfm)</TargetFramework>
    <SupportedOSPlatformVersion>$(ShotAIMinWindows)</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>shotAI</AssemblyName>
    <RootNamespace>ShotAI.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>$(RepoRoot)assets/shotAI_icon.ico</ApplicationIcon>
  </PropertyGroup>
  <!--
    Program.Main is the entry point (spec 12 7.9.1), so App.xaml is a Page: as an
    ApplicationDefinition, WPF would generate a second Main (spec 03 7.4.1).
  -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <!--
    Debugger output in Debug builds only (spec 10 7.5.1). The reference itself is the same in
    every configuration, so the lock file is too; a Release build takes none of its assets.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Update="Microsoft.Extensions.Logging.Debug" ExcludeAssets="all" Condition="'$(Configuration)' != 'Debug'" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ShotAI.Core\ShotAI.Core.csproj" />
    <ProjectReference Include="..\ShotAI.Platform\ShotAI.Platform.csproj" />
  </ItemGroup>
  <!-- The App.Tests project reaches the composition root's internals. -->
  <ItemGroup>
    <InternalsVisibleTo Include="ShotAI.App.Tests" />
  </ItemGroup>
</Project>
