<UserControl x:Class="ShotAI.App.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="clr-namespace:ShotAI.App.Settings"
             xmlns:chrome="clr-namespace:ShotAI.App.Chrome"
             xmlns:ui="clr-namespace:ShotAI.Core.SettingsUi;assembly=ShotAI.Core"
             Focusable="False" IsTabStop="False" Unloaded="OnUnloaded">
  <!--
    Settings (spec 06 2.24 to 2.29, 7.12): the bar with Back and the title, the inline error, the
    tab bar and the shown tab's panel, at most 640 DIP wide, in the one scroller of the view padded
    as .project__body (1.75rem 2rem). Only the shown tab's content exists, as in Electron, each from
    its section's template below. CSS collapses the margins between a group's blocks, so each gap
    here is the larger of the two margins that meet: 0.6rem under a heading, 0.35rem over a hint,
    0.45rem over a chip row, 1rem between the panel's blocks. The shared styles are read with
    DynamicResource, so the view also loads outside the Application (the tests' windows).
  -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />

    <!-- settings__h: fs-title, fw-title, ink, 0.6rem below; a level 3 heading. -->
    <Style x:Key="Heading" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,0,0,9.6" />
      <Setter Property="FontSize" Value="{DynamicResource Fs.title}" />
      <Setter Property="FontWeight" Value="{DynamicResource Fw.title}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.ink}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="AutomationProperties.HeadingLevel" Value="Level3" />
    </Style>

    <!-- settings__hint: 0.82rem, ink-2, line-height 1.4, 0.35rem above. -->
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,5.6,0,0" />
      <Setter Property="FontSize" Value="13.12" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.ink-2}" />
      <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
      <Setter Property="LineHeight" Value="18.368" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- settings__toggle-text strong: fs-title, fw-title, ink. -->
    <Style x:Key="ToggleTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource Fs.title}" />
      <Setter Property="FontWeight" Value="{DynamicResource Fw.title}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.ink}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- A toggle's hint: the column's 0.2rem gap and the hint's own 0.35rem. -->
    <Style x:Key="ToggleHint" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
      <Setter Property="Margin" Value="0,8.8,0,0" />
    </Style>

    <!--
      capmode__modes: chips wrapping with a 0.4rem gap across and down, 0.45rem above. Each chip
      carries the gap on its right and bottom, and the row's negative margins take back the last
      ones, as the CSS gap leaves no space after the last chip. The arrows move the selection (7.9).
    -->
    <Style x:Key="Chips" TargetType="chrome:ChipGroup">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Gap" Value="6.4" />
      <Setter Property="Margin" Value="0,7.2,-6.4,-6.4" />
      <Setter Property="ItemContainerStyle" Value="{DynamicResource Chip}" />
      <Setter Property="ItemsPanel">
        <Setter.Value>
          <ItemsPanelTemplate>
            <WrapPanel chrome:RadioGroupKeys.MovesSelection="True" />
          </ItemsPanelTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The AI tab (2.25): the master switch, then the off line or the SOP option groups. -->
    <DataTemplate DataType="{x:Type settings:AiSettingsViewModel}">
      <StackPanel>
        <CheckBox x:Name="AiSwitch" Style="{DynamicResource SettingsToggleCard}" IsChecked="{Binding Enabled}"
                  AutomationProperties.Name="{x:Static ui:SettingsText.AiSwitch}" AutomationProperties.HelpText="{Binding Hint}">
          <StackPanel>
            <TextBlock Style="{StaticResource ToggleTitle}" Text="{x:Static ui:SettingsText.AiSwitch}" />
            <TextBlock Style="{StaticResource ToggleHint}" Text="{Binding Hint}" />
          </StackPanel>
        </CheckBox>

        <!-- settings__off: 0.9rem 1.1rem, a dashed 1px hair border, radius-panel, ink-3, fs-body. -->
        <Grid x:Name="AiOff" Margin="0,16,0,0" Visibility="{Binding IsOff, Converter={StaticResource Visible}}">
          <Rectangle Stroke="{DynamicResource Brush.hair}" StrokeThickness="1" StrokeDashArray="3 3" SnapsToDevicePixels="True"
                     RadiusX="{DynamicResource RadiusValue.panel}" RadiusY="{DynamicResource RadiusValue.panel}" />
          <TextBlock Margin="17.6,14.4" Text="{Binding OffText}" TextWrapping="Wrap" FontSize="{DynamicResource Fs.body}"
                     Foreground="{DynamicResource Brush.ink-3}" />
        </Grid>

        <StackPanel x:Name="AiOptions" Visibility="{Binding Enabled, Converter={StaticResource Visible}}">
          <Border Margin="0,16,0,0" Style="{DynamicResource SettingsGroup}">
            <StackPanel>
              <TextBlock Style="{StaticResource Heading}" Text="{x:Static ui:SettingsText.Model}" />
              <chrome:ChipGroup x:Name="ModelChips" Margin="0,0,-6.4,-6.4" Style="{StaticResource Chips}" ItemsSource="{Binding Models}"
                                AutomationProperties.Name="{x:Static ui:SettingsText.Model}" />
              <TextBlock Style="{StaticResource Hint}" Text="{Binding ModelBlurb}" />
            </StackPanel>
          </Border>
          <Border Margin="0,16,0,0" Style="{DynamicResource SettingsGroup}">
            <StackPanel>
              <TextBlock Style="{StaticResource Heading}" Text="{x:Static ui:SettingsText.Tone}" />
              <chrome:ChipGroup x:Name="ToneChips" Margin="0,0,-6.4,-6.4" Style="{StaticResource Chips}" ItemsSource="{Binding Tones}"
                                AutomationProperties.Name="{x:Static ui:SettingsText.Tone}" />
              <TextBlock Style="{StaticResource Hint}" Text="{Binding ToneBlurb}" />
            </StackPanel>
          </Border>
          <Border Margin="0,16,0,0" Style="{DynamicResource SettingsGroup}">
            <StackPanel>
              <TextBlock Style="{StaticResource Heading}" Text="{x:Static ui:SettingsText.Effort}" />
              <chrome:ChipGroup x:Name="EffortChips" Margin="0,0,-6.4,-6.4" Style="{StaticResource Chips}" ItemsSource="{Binding Efforts}"
                                AutomationProperties.Name="{x:Static ui:SettingsText.Effort}" />
              <TextBlock Style="{StaticResource Hint}" Text="{Binding EffortBlurb}" />
            </StackPanel>
          </Border>

          <!--
            settings__textarea: 3 rows at 0.92rem, 0.5rem under the heading's margin, padded and
            outlined as an input. It grows with its text; the placeholder is a TextBlock over it,
            and its help text for assistive tech. Its edits are written when it loses the focus.
          -->
          <Border Margin="0,16,0,0" Style="{DynamicResource SettingsGroup}">
            <StackPanel>
              <TextBlock Style="{StaticResource Heading}" Text="{x:Static ui:SettingsText.CustomInstructions}" />
              <Grid Margin="0,8,0,0">
                <TextBox x:Name="CustomInstructions" Style="{DynamicResource TextInput}" FontSize="14.72" AcceptsReturn="True" TextWrapping="Wrap"
                         MinLines="3" VerticalContentAlignment="Top" MaxLength="2000"
                         Text="{Binding CustomInstructions, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{x:Static ui:SettingsText.CustomInstructions}"
                         AutomationProperties.HelpText="{x:Static ui:SettingsText.CustomInstructionsPlaceholder}"
                         LostKeyboardFocus="OnCustomInstructionsLostFocus" />
                <TextBlock Margin="13,9.8,13,0" VerticalAlignment="Top" IsHitTestVisible="False" FontSize="14.72" TextWrapping="Wrap"
                           Text="{x:Static ui:SettingsText.CustomInstructionsPlaceholder}" Foreground="{DynamicResource Brush.ink-3}"
                           Visibility="{Binding ShowsCustomInstructionsPlaceholder, Converter={StaticResource Visible}}" />
              </Grid>
              <TextBlock x:Name="CustomInstructionsCount" Style="{StaticResource Hint}" Text="{Binding CustomInstructionsCount}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </DataTemplate>

    <!--
      The Capture tab (2.26): the quality group, whose slider row is 0.4rem under the hint, the value
      0.9rem after the slider (600, tabular, ink, at least 3ch), then the remote visibility switch.
      The slider writes when the pointer or a key is released.
    -->
    <DataTemplate DataType="{x:Type settings:CaptureSettingsViewModel}">
      <StackPanel>
        <Border Style="{DynamicResource SettingsGroup}">
          <StackPanel>
            <TextBlock Style="{StaticResource Heading}" Text="{x:Static ui:SettingsText.ScreenshotQuality}" />
            <TextBlock Margin="0" Style="{StaticResource Hint}" Text="{x:Static ui:SettingsText.ScreenshotQualityHint}" />
            <Grid Margin="0,6.4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Slider x:Name="Quality" VerticalAlignment="Center" Style="{DynamicResource Range}" Minimum="0.5" Maximum="1" SmallChange="0.05"
                      LargeChange="0.05" TickFrequency="0.05" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Value="{Binding Scale}"
                      AutomationProperties.Name="{x:Static ui:SettingsText.ScreenshotQuality}"
                      Thumb.DragCompleted="OnQualityReleased" PreviewMouseUp="OnQualityReleased" KeyUp="OnQualityReleased" />
              <TextBlock x:Name="QualityValue" Grid.Column="1" Margin="14.4,0,0,0" MinWidth="27" VerticalAlignment="Center" TextAlignment="Right"
                         Text="{Binding ScaleLabel}" FontSize="16" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"
                         Foreground="{DynamicResource Brush.ink}" />
            </Grid>
          </StackPanel>
        </Border>
        <CheckBox x:Name="RemoteVisible" Margin="0,16,0,0" Style="{DynamicResource SettingsToggleCard}" IsChecked="{Binding RemoteVisible}"
                  AutomationProperties.Name="{x:Static ui:SettingsText.RemoteVisible}"
                  AutomationProperties.HelpText="{x:Static ui:SettingsText.RemoteVisibleHint}">
          <StackPanel>
            <TextBlock Style="{StaticResource ToggleTitle}" Text="{x:Static ui:SettingsText.RemoteVisible}" />
            <TextBlock Style="{StaticResource ToggleHint}" Text="{x:Static ui:SettingsText.RemoteVisibleHint}" />
          </StackPanel>
        </CheckBox>
      </StackPanel>
    </DataTemplate>

    <!--
      The Appearance tab (2.27): one group, Theme then Brand. A hint has no bottom margin and a
      heading no top one, so the Brand heading sits right under the theme's blurb, as in Electron.
    -->
    <DataTemplate DataType="{x:Type settings:AppearanceSettingsViewModel}">
      <Border Style="{DynamicResource SettingsGroup}">
        <StackPanel>
          <TextBlock Style="{StaticResource Heading}" Text="{x:Static ui:SettingsText.Theme}" />
          <TextBlock Margin="0" Style="{StaticResource Hint}" Text="{x:Static ui:SettingsText.ThemeHint}" />
          <chrome:ChipGroup x:Name="ThemeChips" Style="{StaticResource Chips}" ItemsSource="{Binding Themes}"
                            AutomationProperties.Name="{x:Static ui:SettingsText.Theme}" />
          <TextBlock Style="{StaticResource Hint}" Text="{Binding ThemeBlurb}" />
          <TextBlock Style="{StaticResource Heading}" Text="{x:Static ui:SettingsText.Brand}" />
          <TextBlock Margin="0" Style="{StaticResource Hint}" Text="{x:Static ui:SettingsText.BrandHint}" />
          <TextBlock Style="{StaticResource Hint}" Text="{x:Static ui:SettingsText.BrandExportsHint}" />
          <chrome:ChipGroup x:Name="BrandChips" Style="{StaticResource Chips}" ItemsSource="{Binding Brands}"
                            AutomationProperties.Name="{x:Static ui:SettingsText.Brand}" />
          <TextBlock Style="{StaticResource Hint}" Text="{Binding BrandBlurb}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <!--
      The Storage tab (2.28): the folder group, its row 0.2rem under the hint (the path in the
      monospace face at fs-meta and ink-2, one line with an ellipsis and the whole path as its tip,
      then Change... 0.6rem after it), and the auto-archive group with its select under the hint.
    -->
    <DataTemplate DataType="{x:Type settings:StorageSettingsViewModel}">
      <StackPanel>
        <Border Style="{DynamicResource SettingsGroup}">
          <StackPanel>
            <TextBlock Style="{StaticResource Heading}" Text="{x:Static ui:SettingsText.ProjectsFolder}" />
            <TextBlock Margin="0" Style="{StaticResource Hint}" Text="{x:Static ui:SettingsText.ProjectsFolderHint}" />
            <Grid Margin="0,3.2,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="ProjectsDir" VerticalAlignment="Center" Text="{Binding ProjectsDir}" ToolTip="{Binding ProjectsDir}"
                         TextTrimming="CharacterEllipsis" FontFamily="Consolas" FontSize="{DynamicResource Fs.meta}"
                         Foreground="{DynamicResource Brush.ink-2}" />
              <Button x:Name="ChangeFolder" Grid.Column="1" Margin="9.6,0,0,0" VerticalAlignment="Center" Style="{DynamicResource Button.Small}"
                      Content="{x:Static ui:SettingsText.ChangeFolder}" Command="{Binding ChangeProjectsDirCommand}"
                      CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
            </Grid>
          </StackPanel>
        </Border>
        <Border Margin="0,16,0,0" Style="{DynamicResource SettingsGroup}">
          <StackPanel>
            <TextBlock Style="{StaticResource Heading}" Text="{x:Static ui:SettingsText.AutoArchive}" />
            <TextBlock Margin="0" Style="{StaticResource Hint}" Text="{x:Static ui:SettingsText.AutoArchiveHint}" />
            <ComboBox x:Name="ArchiveAge" HorizontalAlignment="Left" MinWidth="160" Style="{DynamicResource SelectInput}"
                      ItemsSource="{Binding ArchiveAges}" SelectedItem="{Binding ArchiveAge}" DisplayMemberPath="Label"
                      AutomationProperties.Name="{x:Static ui:SettingsText.AutoArchiveName}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </DataTemplate>

    <!--
      The About tab (2.29): the name group (the field under the hint at Chromium's 20-character
      input width, and the Include switch 0.75rem under it), the About line, and the update check's
      switch. The name is written when its field loses the focus.
    -->
    <DataTemplate DataType="{x:Type settings:AboutSettingsViewModel}">
      <StackPanel>
        <Border Style="{DynamicResource SettingsGroup}">
          <StackPanel>
            <TextBlock Style="{StaticResource Heading}" Text="{x:Static ui:SettingsText.YourName}" />
            <TextBlock Margin="0" Style="{StaticResource Hint}" Text="{x:Static ui:SettingsText.YourNameHint}" />
            <Grid Width="220" HorizontalAlignment="Left">
              <TextBox x:Name="UserName" Style="{DynamicResource TextInput}" MaxLength="120" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="{x:Static ui:SettingsText.YourName}"
                       AutomationProperties.HelpText="{x:Static ui:SettingsText.YourNamePlaceholder}"
                       LostKeyboardFocus="OnUserNameLostFocus" />
              <TextBlock Margin="13,0,13,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="15.2" TextTrimming="CharacterEllipsis"
                         Text="{x:Static ui:SettingsText.YourNamePlaceholder}" Foreground="{DynamicResource Brush.ink-3}"
                         Visibility="{Binding ShowsUserNamePlaceholder, Converter={StaticResource Visible}}" />
            </Grid>
            <CheckBox x:Name="IncludeName" Margin="0,12,0,0" Style="{DynamicResource SettingsToggleCard}" IsChecked="{Binding IncludeName}"
                      IsEnabled="{Binding CanIncludeName}" AutomationProperties.Name="{x:Static ui:SettingsText.IncludeName}"
                      AutomationProperties.HelpText="{x:Static ui:SettingsText.IncludeNameHint}">
              <StackPanel>
                <TextBlock Style="{StaticResource ToggleTitle}" Text="{x:Static ui:SettingsText.IncludeName}" />
                <TextBlock Style="{StaticResource ToggleHint}" Text="{x:Static ui:SettingsText.IncludeNameHint}" />
              </StackPanel>
            </CheckBox>
          </StackPanel>
        </Border>
        <Border Margin="0,16,0,0" Style="{DynamicResource SettingsGroup}">
          <StackPanel>
            <TextBlock Style="{StaticResource Heading}" Text="{x:Static ui:SettingsText.About}" />
            <TextBlock x:Name="AppInfo" Margin="0" Style="{StaticResource Hint}" Text="{Binding AppInfoLine, Mode=OneTime}" />
          </StackPanel>
        </Border>
        <Border Margin="0,16,0,0" Style="{DynamicResource SettingsGroup}">
          <StackPanel>
            <TextBlock Style="{StaticResource Heading}" Text="{x:Static ui:SettingsText.Updates}" />
            <CheckBox x:Name="UpdateCheck" Style="{DynamicResource SettingsToggleCard}" IsChecked="{Binding UpdateCheckEnabled}"
                      AutomationProperties.Name="{x:Static ui:SettingsText.CheckForUpdates}"
                      AutomationProperties.HelpText="{x:Static ui:SettingsText.CheckForUpdatesHint}">
              <StackPanel>
                <TextBlock Style="{StaticResource ToggleTitle}" Text="{x:Static ui:SettingsText.CheckForUpdates}" />
                <TextBlock Style="{StaticResource ToggleHint}" Text="{x:Static ui:SettingsText.CheckForUpdatesHint}" />
              </StackPanel>
            </CheckBox>
          </StackPanel>
        </Border>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False">
    <Grid Margin="32,28">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MaxWidth="640" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <!-- settings__bar: Back (btn btn-small) and the title (fs-section, fw-section) 0.8rem apart, 1.25rem above the rest. -->
        <StackPanel Margin="0,0,0,20" Orientation="Horizontal">
          <Button x:Name="Back" VerticalAlignment="Center" Style="{DynamicResource Button.Small}" Content="{x:Static ui:SettingsText.Back}"
                  Command="{Binding BackCommand}" />
          <TextBlock Margin="12.8,0,0,0" VerticalAlignment="Center" Text="{x:Static ui:SettingsText.Title}" FontSize="{DynamicResource Fs.section}"
                     FontWeight="{DynamicResource Fw.section}" AutomationProperties.HeadingLevel="Level2" />
        </StackPanel>

        <!-- project__error: danger-ink on danger-tint, radius-control, 0.6rem 0.8rem, 0.9rem, 1rem above the tabs. -->
        <Border x:Name="Error" Margin="0,0,0,16" Padding="12.8,9.6" CornerRadius="{DynamicResource Radius.control}"
                Background="{DynamicResource Brush.danger-tint}" Visibility="{Binding HasError, Converter={StaticResource Visible}}">
          <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" FontSize="14.4" Foreground="{DynamicResource Brush.danger-ink}" />
        </Border>

        <!-- settings__tabs: underline tabs 0.25rem apart on a 1px hair line, 1.25rem above the panel. -->
        <Border Margin="0,0,0,20" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.hair}">
          <settings:SettingsTabStrip x:Name="Tabs" AutomationProperties.Name="{x:Static ui:SettingsText.TabsName}">
            <settings:SettingsTabButton x:Name="AiTab" Margin="0,0,4,-1" Style="{DynamicResource TabUnderline}" Content="{x:Static ui:SettingsText.AiTab}"
                                        IsChecked="{Binding IsAiTab}" />
            <settings:SettingsTabButton x:Name="CaptureTab" Margin="0,0,4,-1" Style="{DynamicResource TabUnderline}" Content="{x:Static ui:SettingsText.CaptureTab}"
                                        IsChecked="{Binding IsCaptureTab}" />
            <settings:SettingsTabButton x:Name="AppearanceTab" Margin="0,0,4,-1" Style="{DynamicResource TabUnderline}" Content="{x:Static ui:SettingsText.AppearanceTab}"
                                        IsChecked="{Binding IsAppearanceTab}" />
            <settings:SettingsTabButton x:Name="StorageTab" Margin="0,0,4,-1" Style="{DynamicResource TabUnderline}" Content="{x:Static ui:SettingsText.StorageTab}"
                                        IsChecked="{Binding IsStorageTab}" />
            <settings:SettingsTabButton x:Name="AboutTab" Margin="0,0,0,-1" Style="{DynamicResource TabUnderline}" Content="{x:Static ui:SettingsText.AboutTab}"
                                        IsChecked="{Binding IsAboutTab}" />
          </settings:SettingsTabStrip>
        </Border>

        <!-- settings__panel: the shown tab, a Tab stop of its own (INV-HOME-39), named after its tab. -->
        <settings:SettingsTabPanel x:Name="Panel" Focusable="True" IsTabStop="True" FocusVisualStyle="{DynamicResource FocusVisual}"
                                   Content="{Binding ActiveSection}" AutomationProperties.Name="{Binding ActiveTabLabel}" />
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
