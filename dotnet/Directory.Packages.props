<Project>
  <!-- Central package management: every version lives here, never in a .csproj.
       Versions are exact (ARCHITECTURE 3.1 V2); a change regenerates the lock files. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.335" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>
  <!-- Core: the logging and DI abstractions every subsystem builds on, and CRC-32 for the
       archive check (ARCHITECTURE 3.2). -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="System.IO.Hashing" Version="10.0.12" />
  </ItemGroup>
  <!-- Platform: the app-mode change notification of the theme monitor (spec 06 7.14). The App's
       desktop runtime carries the same assembly; this reference keeps Platform off WPF. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Win32.SystemEvents" Version="10.0.12" />
  </ItemGroup>
  <!-- App: the container, the logger factory and its debugger output, and the MVVM toolkit
       (ARCHITECTURE 3.2). -->
  <ItemGroup>
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
  </ItemGroup>
  <!-- Analyzers, referenced from Directory.Build.props with PrivateAssets="all" (V7). -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23" />
  </ItemGroup>
  <!-- Tests. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
  </ItemGroup>
</Project>
