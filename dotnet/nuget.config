<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet configuration for everything under dotnet/ (docs/native/spec/12-packaging-deploy-ci.md
  7.8, INV-PKG-20, ARCHITECTURE 3.1 V4). One source, nuget.org, with every package mapped to
  it, and only packages repository-signed by nuget.org are accepted.

  The trusted certificates are the ones nuget.org announces in its repository signatures
  resource (https://api.nuget.org/v3-index/repository-signatures/5.0.0/index.json), written
  by "dotnet nuget trust source nuget.org". When nuget.org rotates its certificate, restore
  fails with NU3034 until the list is refreshed with "dotnet nuget trust sync nuget.org".
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <config>
    <add key="signatureValidationMode" value="require" />
  </config>
  <trustedSigners>
    <repository name="nuget.org" serviceIndex="https://api.nuget.org/v3/index.json">
      <certificate fingerprint="0e5f38f57dc1bcc806d8494f4f90fbcedd988b46760709cbeec6f4219aa6157d" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <certificate fingerprint="5a2901d6ada3d18260b9c6dfe2133c95d74b9eef6ae0e5dc334c8454d1477df4" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <certificate fingerprint="1f4b311d9acc115c8dc8018b5a49e00fce6da8e2855f9f014ca6f34570bc482d" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
    </repository>
  </trustedSigners>
</configuration>
