<Project>
  <!--
    Shared build settings for every project under dotnet/.

    EnableWindowsTargeting lets the Windows-only projects (WPF, CsWin32 interop) BUILD
    on Linux and macOS. They cannot run there, but compiling them is what lets the
    Linux CI job and cloud sessions catch a broken build before a Windows runner does.
  -->
  <PropertyGroup>
    <RepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..'))</RepoRoot>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <Product>shotAI</Product>
    <Company>LFI</Company>
    <!-- Native builds ship as prereleases until cutover, so the Electron app's update
         check (which refuses prereleases) never offers them. See docs/native/PLAN.md. -->
    <Version>2.0.0-alpha.0</Version>
  </PropertyGroup>

  <!-- The minimum Windows build. 10.0.19041 (Windows 10 2004) is the first with
       WDA_EXCLUDEFROMCAPTURE, which keeps shotAI's own windows out of its captures. -->
  <PropertyGroup>
    <ShotAIWindowsTfm>net10.0-windows10.0.19041.0</ShotAIWindowsTfm>
    <ShotAIMinWindows>10.0.19041.0</ShotAIMinWindows>
  </PropertyGroup>

  <!--
    Supply chain (docs/native/spec/12-packaging-deploy-ci.md 7.8, INV-PKG-20). Restore is
    locked to the committed packages.lock.json files, and CI (GitHub Actions sets CI=true)
    fails instead of silently resolving something new. After a package change, regenerate
    the lock files with the force-evaluate restore in docs/native/PLAN.md 2.5.
  -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <!-- Q-PKG-14, ARCHITECTURE 3.1 V5: low and moderate advisories stay warnings outside the
         release workflow, whose test job passes -p:ShotAIStrictAudit=true so they fail there too. -->
    <WarningsNotAsErrors Condition="'$(ShotAIStrictAudit)' != 'true'">$(WarningsNotAsErrors);NU1901;NU1902</WarningsNotAsErrors>
  </PropertyGroup>

  <!--
    Analyzers for every project (ARCHITECTURE 14.9; severities are in .editorconfig).
    tools/ShotAI.GenBrand stays BCL-only with no package reference at all (spec 10 7.3).
    BannedSymbols.txt, where a project has one, is the banned-API list for RS0030.
  -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'ShotAI.GenBrand'">
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildProjectDirectory)/BannedSymbols.txt"
                     Condition="Exists('$(MSBuildProjectDirectory)/BannedSymbols.txt')" />
  </ItemGroup>
</Project>
