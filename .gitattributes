# Normalise line endings in the working tree by default.
* text=auto

# THE CROSS-REPO CONTRACT — pin to LF, unconditionally.
#
# `contract/brand.json` is hashed byte-for-byte and the digest is stamped into
# the generated tables in BOTH this repo and Armadillon44/shotAI_MacOS. That
# stamp is the only thing making "the two repos hold the same contract" visible
# in a diff. A default Windows clone (core.autocrlf=true) rewrites the worktree
# copy to CRLF, which changes the digest — so the file must never be converted.
#
# The same applies to the generated outputs: the staleness check compares them
# byte-for-byte against freshly generated LF output.
contract/**                        text eol=lf
src/shared/brand-colors.generated.ts text eol=lf
dotnet/src/ShotAI.Core/Brand/BrandPalette.Generated.cs text eol=lf

# Shell scripts must stay LF or they will not execute.
*.sh text eol=lf

# Native test goldens (docs/native/PLAN.md WP-A3). The tests compare these files byte for
# byte, so text goldens stay LF on every checkout, including a Windows runner's.
dotnet/tests/ShotAI.Core.Tests/Golden/**/*.json text eol=lf
dotnet/tests/ShotAI.Core.Tests/Golden/**/*.css  text eol=lf
dotnet/tests/ShotAI.Core.Tests/Golden/**/*.html text eol=lf
dotnet/tests/ShotAI.Core.Tests/Golden/**/*.md   text eol=lf
dotnet/tests/ShotAI.Core.Tests/Golden/**/*.txt  text eol=lf
# Binary goldens are never converted. Marked explicitly, because a pattern that says
# `text` would switch off binary detection and rewrite bytes inside them.
dotnet/tests/ShotAI.Core.Tests/Golden/**/*.png  binary
dotnet/tests/ShotAI.Core.Tests/Golden/**/*.jpg  binary
dotnet/tests/ShotAI.Core.Tests/Golden/**/*.jpeg binary
dotnet/tests/ShotAI.Core.Tests/Golden/**/*.avif binary
dotnet/tests/ShotAI.Core.Tests/Golden/**/*.pdf  binary
dotnet/tests/ShotAI.Core.Tests/Golden/**/*.docx binary
dotnet/tests/ShotAI.Core.Tests/Golden/**/*.pptx binary
dotnet/tests/ShotAI.Core.Tests/Golden/**/*.zip  binary

# Fonts (docs/native/spec/10-brand-settings-infra.md 7.9). A font is binary, and the licence
# beside each copy stays byte-identical to upstream's on every checkout, so the hashes in
# dotnet/assets/fonts/static/SOURCES.md hold on a Windows runner's CRLF checkout too.
*.ttf binary
src/renderer/fonts/OFL.txt          text eol=lf
dotnet/assets/fonts/**/OFL.txt      text eol=lf
